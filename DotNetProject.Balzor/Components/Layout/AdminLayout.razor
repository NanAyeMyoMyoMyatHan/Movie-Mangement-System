@inherits LayoutComponentBase

<div class="admin-shell">
    <!-- Admin Sidebar matching NANGWORLD -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-top">
            <!-- Brand Logo -->
            <div class="myflix-logo" style="margin-bottom: 20px;">
                <svg class="myflix-logo-icon" width="26" height="26" viewBox="0 0 24 24" fill="#DE7149">
                    <path d="M6 3.5c0-.9 1-.1.4.1l13.5 7.5c.8.5.8 1.6 0 2.1L7.4 20.6c-.6.4-1.4 0-1.4-.8V3.5z" />
                </svg>
                <div>
                    <span class="myflix-logo-text">
                        <span class="myflix-text-white">Nang</span><span class="myflix-text-green">World</span>
                    </span>
                    <span class="admin-panel-badge">Admin Panel</span>
                </div>
            </div>

            <!-- Nav Links -->
            <nav class="myflix-nav">
                <p class="admin-nav-label">Overview</p>
                <NavLink href="admin" Match="NavLinkMatch.All" class="myflix-nav-item">
                    <div class="myflix-nav-left">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
                        </svg>
                        <span>Dashboard</span>
                    </div>
                </NavLink>

                <p class="admin-nav-label">Content Management</p>
                <NavLink href="admin/movies" class="myflix-nav-item">
                    <div class="myflix-nav-left">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2.5" />
                            <line x1="2" y1="9" x2="22" y2="9" />
                            <line x1="7" y1="4" x2="7" y2="9" />
                            <line x1="12" y1="4" x2="12" y2="9" />
                            <line x1="17" y1="4" x2="17" y2="9" />
                        </svg>
                        <span>Movies</span>
                    </div>
                </NavLink>

                <NavLink href="admin/contents" class="myflix-nav-item">
                    <div class="myflix-nav-left">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <path d="M8 21h8M12 17v4" />
                        </svg>
                        <span>Dramas &amp; Series</span>
                    </div>
                </NavLink>

                <NavLink href="admin/episodes" class="myflix-nav-item">
                    <div class="myflix-nav-left">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>Episodes</span>
                    </div>
                </NavLink>

                <p class="admin-nav-label">System</p>
                <NavLink href="admin/users" class="myflix-nav-item">
                    <div class="myflix-nav-left">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        <span>Users</span>
                    </div>
                    <span class="myflix-badge">3.2k</span>
                </NavLink>
            </nav>

            <!-- Status Card -->
            <div class="admin-status-card">
                <div class="admin-status-header">
                    <span class="admin-status-dot"></span>
                    <span>System Status</span>
                </div>
                <p class="admin-status-text">API · DB · Storage healthy</p>
            </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="admin-sidebar-footer">
            <div class="admin-user-card">
                <div class="admin-avatar">MZ</div>
                <div class="admin-user-info">
                    <span class="admin-user-name">May Zin</span>
                    <span class="admin-user-role">🛡 Super Admin</span>
                </div>
            </div>
            <a href="/" class="admin-back-client" title="Back to User View">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                </svg>
            </a>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="admin-main">
        @Body
    </div>
</div>

<!-- Blazor Error UI -->
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
