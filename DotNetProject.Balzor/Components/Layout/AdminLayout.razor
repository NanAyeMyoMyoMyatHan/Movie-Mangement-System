@inherits LayoutComponentBase
@using DotNetProject.Balzor.Components.Shared
@inject AuthService AuthService
@inject NavigationManager Nav

@if (!AuthService.IsAdmin())
{
    <div style="min-height: 100vh; background: #0F2420; display: flex; align-items: center; justify-content: center; color: #F4EFEA; font-family: 'Plus Jakarta Sans', sans-serif;">
        <div style="text-align: center; max-width: 400px; padding: 40px; background: rgba(255,255,255,0.03); border: 1px solid rgba(222,113,73,0.2); border-radius: 20px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#DE7149" stroke-width="2" style="margin-bottom: 16px;">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">Admin Authorization Required</h2>
            <p style="color: #9ab4ae; font-size: 14px; margin-bottom: 24px;">Please sign in with administrator credentials to access the NangWorld Admin Panel.</p>
            <a href="/login?returnUrl=/admin" style="display: inline-block; padding: 12px 28px; background: #DE7149; color: #fff; border-radius: 12px; font-weight: 700; text-decoration: none;">
                Sign In as Admin
            </a>
        </div>
    </div>
}
else
{
    <div class="admin-shell">
        <!-- Admin Sidebar matching NANGWORLD -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-top">
                <!-- Brand Logo -->
                <div class="myflix-logo" style="margin-bottom: 20px;">
                    <svg class="myflix-logo-icon" width="26" height="26" viewBox="0 0 24 24" fill="#DE7149">
                        <path d="M6 3.5c0-.9 1-.1.4.1l13.5 7.5c.8.5.8 1.6 0 2.1L7.4 20.6c-.6.4-1.4 0-1.4-.8V3.5z" />
                    </svg>
                    <div>
                        <span class="myflix-logo-text">
                            <span class="myflix-text-white">Nang</span><span class="myflix-text-green">World</span>
                        </span>
                        <span class="admin-panel-badge">Admin Panel</span>
                    </div>
                </div>

                <!-- Nav Links -->
                <nav class="myflix-nav">
                    <p class="admin-nav-label">Overview</p>
                    <NavLink href="/admin" Match="NavLinkMatch.All" class="myflix-nav-item">
                        <div class="myflix-nav-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
                            </svg>
                            <span>Dashboard</span>
                        </div>
                    </NavLink>

                    <p class="admin-nav-label">Content Management</p>
                    <NavLink href="/admin/movies" class="myflix-nav-item">
                        <div class="myflix-nav-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2.5" />
                                <line x1="2" y1="9" x2="22" y2="9" />
                                <line x1="7" y1="4" x2="7" y2="9" />
                                <line x1="12" y1="4" x2="12" y2="9" />
                                <line x1="17" y1="4" x2="17" y2="9" />
                            </svg>
                            <span>Movies</span>
                        </div>
                    </NavLink>

                    <NavLink href="/admin/contents" class="myflix-nav-item">
                        <div class="myflix-nav-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2" />
                                <path d="M8 21h8M12 17v4" />
                            </svg>
                            <span>Dramas &amp; Series</span>
                        </div>
                    </NavLink>

                    <NavLink href="/admin/episodes" class="myflix-nav-item">
                        <div class="myflix-nav-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>Episodes</span>
                        </div>
                    </NavLink>

                    <p class="admin-nav-label">System</p>
                    <NavLink href="/admin/users" class="myflix-nav-item">
                        <div class="myflix-nav-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                            <span>Users</span>
                        </div>
                        <span class="myflix-badge">Active</span>
                    </NavLink>
                </nav>

                <!-- Status Card -->
                <div class="admin-status-card">
                    <div class="admin-status-header">
                        <span class="admin-status-dot"></span>
                        <span>System Status</span>
                    </div>
                    <p class="admin-status-text">API · DB · Storage healthy</p>
                </div>
            </div>

            <!-- Sidebar Footer -->
            <div class="admin-sidebar-bottom">
                <a href="/" class="admin-userview-btn" title="Back to User View">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>User View</span>
                </a>

                <div class="admin-user-card">
                    <div class="admin-avatar">
                        @(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "A" : AuthService.CurrentUser.DisplayName.Substring(0, 1).ToUpper())
                    </div>
                    <div class="admin-user-info">
                        <span class="admin-user-name">@(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "Admin" : AuthService.CurrentUser.DisplayName)</span>
                        <span class="admin-user-role">🛡 Administrator</span>
                    </div>
                </div>

                <button type="button" class="admin-logout-btn" @onclick="HandleLogout" title="Log Out">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Log Out</span>
                </button>
            </div>
        </aside>

        <!-- Main content area -->
        <div class="admin-main">
            @Body
        </div>
    </div>
}

<!-- Blazor Error UI -->
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!AuthService.IsAdmin())
        {
            Nav.NavigateTo("/login?returnUrl=/admin");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
