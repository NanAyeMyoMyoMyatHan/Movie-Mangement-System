@inherits LayoutComponentBase
@using DotNetProject.Balzor.Components.Shared
@inject AuthService AuthService
@inject NavigationManager Nav

<link rel="stylesheet" href="admin.css?v=pastel-2.1" />

@if (!CanAccessAdminPanel)
{
    <div style="min-height: 100vh; background: linear-gradient(145deg, #FAF5FF 0%, #F5EEFD 45%, #FDF2F8 100%); display: flex; align-items: center; justify-content: center; color: #2E1065; font-family: 'Plus Jakarta Sans', sans-serif;">
        <div style="text-align: center; max-width: 440px; padding: 44px 36px; background: rgba(255,255,255,0.98); border: 1.5px solid rgba(167,139,250,0.35); border-radius: 26px; box-shadow: 0 20px 50px rgba(139,92,246,0.16);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#EC4899" stroke-width="2" style="margin-bottom: 16px;">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <h2 style="font-size: 22px; font-weight: 800; color: #2E1065; margin-bottom: 10px;">Admin Authorization Required</h2>
            <p style="color: #4C1D95; font-size: 14px; line-height: 1.5; margin-bottom: 24px;">Please sign in with authorized credentials to access the NangWorld Admin Panel.</p>
            <a href="/login?returnUrl=/admin" style="display: inline-block; padding: 12px 28px; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 100%); color: #fff; border-radius: 9999px; font-weight: 700; text-decoration: none; box-shadow: 0 6px 20px rgba(139,92,246,0.35);">
                Sign In to Admin
            </a>
        </div>
    </div>
}
else
{
    <div class="admin-shell">
        <!-- Admin Sidebar matching NANGWORLD -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-top">
                <!-- Brand Logo matching NANGWORLD -->
                <div class="myflix-logo" style="margin-bottom: 22px;">
                    <div class="myflix-logo-badge">
                        <svg class="myflix-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="url(#violetPinkGradAdmin)">
                            <defs>
                                <linearGradient id="violetPinkGradAdmin" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#8B5CF6"/>
                                    <stop offset="100%" stop-color="#EC4899"/>
                                </linearGradient>
                            </defs>
                            <path d="M5 3.5c0-.9 1-.1.4.1l13.5 7.5c.8.5.8 1.6 0 2.1L7.4 20.6c-.6.4-1.4 0-1.4-.8V3.5z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="myflix-logo-text">
                            <span class="myflix-text-pink">NANG</span><span class="myflix-text-violet">WORLD</span>
                        </div>
                        <span class="admin-panel-badge">Admin Panel</span>
                    </div>
                </div>

                <!-- Nav Links -->
                <nav class="myflix-nav">
                    @if (AuthService.HasPermission("Dashboard.View"))
                    {
                        <p class="admin-nav-label">Overview</p>
                        <NavLink href="/admin" Match="NavLinkMatch.All" class="myflix-nav-item">
                            <div class="myflix-nav-left">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
                                    <rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
                                </svg>
                                <span>Dashboard</span>
                            </div>
                        </NavLink>
                    }

                    @if (AuthService.HasAnyPermission("Content.View", "Episode.View"))
                    {
                        <p class="admin-nav-label">Content Management</p>
                        @if (AuthService.HasPermission("Content.View"))
                        {
                            <NavLink href="/admin/movies" class="myflix-nav-item">
                                <div class="myflix-nav-left">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2.5" />
                                        <line x1="2" y1="9" x2="22" y2="9" />
                                        <line x1="7" y1="4" x2="7" y2="9" />
                                        <line x1="12" y1="4" x2="12" y2="9" />
                                        <line x1="17" y1="4" x2="17" y2="9" />
                                    </svg>
                                    <span>Movies</span>
                                </div>
                            </NavLink>

                            <NavLink href="/admin/contents" class="myflix-nav-item">
                                <div class="myflix-nav-left">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="3" width="20" height="14" rx="2" />
                                        <path d="M8 21h8M12 17v4" />
                                    </svg>
                                    <span>Dramas &amp; Series</span>
                                </div>
                            </NavLink>
                        }

                        @if (AuthService.HasPermission("Episode.View"))
                        {
                            <NavLink href="/admin/episodes" class="myflix-nav-item">
                                <div class="myflix-nav-left">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                    </svg>
                                    <span>Episodes</span>
                                </div>
                            </NavLink>
                        }
                    }

                    @if (AuthService.HasAnyPermission("User.View", "Role.View"))
                    {
                        <p class="admin-nav-label">System &amp; Access</p>
                        @if (AuthService.HasPermission("User.View"))
                        {
                            <NavLink href="/admin/users" class="myflix-nav-item">
                                <div class="myflix-nav-left">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                                    </svg>
                                    <span>Users</span>
                                </div>
                                <span class="myflix-badge">Active</span>
                            </NavLink>
                        }

                        @if (AuthService.HasPermission("Role.View"))
                        {
                            <NavLink href="/admin/roles" class="myflix-nav-item">
                                <div class="myflix-nav-left">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    <span>Roles &amp; Permissions</span>
                                </div>
                            </NavLink>
                        }

                        <NavLink href="/admin/audit-logs" class="myflix-nav-item">
                            <div class="myflix-nav-left">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                                <span>Audit Logs</span>
                            </div>
                        </NavLink>
                    }
                </nav>

                <!-- Status Card -->
                <div class="admin-status-card">
                    <div class="admin-status-header">
                        <span class="admin-status-dot"></span>
                        <span>System Status</span>
                    </div>
                    <p class="admin-status-text">RBAC · DB · Storage healthy</p>
                </div>
            </div>

            <!-- Sidebar Footer -->
            <div class="admin-sidebar-bottom">
                <div class="admin-user-card">
                    <div class="admin-avatar">
                        @(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "A" : AuthService.CurrentUser.DisplayName.Substring(0, 1).ToUpper())
                    </div>
                    <div class="admin-user-info">
                        <span class="admin-user-name">@(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "Admin" : AuthService.CurrentUser.DisplayName)</span>
                        <span class="admin-user-role">🛡 @(AuthService.CurrentUser.Roles.Any() ? string.Join(", ", AuthService.CurrentUser.Roles) : AuthService.CurrentUser.Role)</span>
                    </div>
                </div>

                <button type="button" class="admin-logout-btn" @onclick="HandleLogout" title="Log Out">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Log Out</span>
                </button>
            </div>
        </aside>

        <!-- Main content area -->
        <div class="admin-main">
            @Body
        </div>
    </div>
}

<!-- Blazor Error UI -->
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool CanAccessAdminPanel => AuthService.CanAccessAdmin();

    protected override void OnInitialized()
    {
        if (!CanAccessAdminPanel)
        {
            Nav.NavigateTo("/login?returnUrl=/admin");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
