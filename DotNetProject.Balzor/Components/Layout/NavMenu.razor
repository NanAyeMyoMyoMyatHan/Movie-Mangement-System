@using DotNetProject.Balzor.Components.Shared
@inject WatchLaterService WatchLaterService
@inject FavoriteService FavoriteService
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

<aside class="petale-sidebar myflix-sidebar">
    <div class="petale-sidebar-top">
        <!-- Brand Logo with Soft Pink & Soft Violet Gradient -->
        <a href="/" class="myflix-logo">
            <div class="myflix-logo-badge">
                <svg class="myflix-logo-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M6 3.5c0-.9 1-.1.4.1l13.5 7.5c.8.5.8 1.6 0 2.1L7.4 20.6c-.6.4-1.4 0-1.4-.8V3.5z" fill="url(#navBrandGrad)" />
                    <defs>
                        <linearGradient id="navBrandGrad" x1="6" y1="3.5" x2="20" y2="20.6" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#A78BFA" />
                            <stop offset="1" stop-color="#F472B6" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <span class="myflix-logo-text">
                <span class="myflix-text-pink">Nang</span><span class="myflix-text-violet">World</span>
            </span>
        </a>

        <!-- Main Navigation -->
        <nav class="myflix-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="myflix-nav-item">
                <div class="myflix-nav-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Home</span>
                </div>
            </NavLink>

            <NavLink href="/watch-later" class="myflix-nav-item">
                <div class="myflix-nav-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Watch Later</span>
                </div>
                @if (AuthService.IsAuthenticated() && WatchCount > 0)
                {
                    <span class="myflix-badge badge-violet">@WatchCount</span>
                }
            </NavLink>

            <NavLink href="/favorites" class="myflix-nav-item">
                <div class="myflix-nav-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                    <span>Favorites</span>
                </div>
                @if (AuthService.IsAuthenticated() && FavoriteCount > 0)
                {
                    <span class="myflix-badge badge-pink">@FavoriteCount</span>
                }
            </NavLink>
        </nav>

        <!-- Divider -->
        <div class="myflix-divider"></div>

        <!-- Special Categories -->
        <div class="myflix-category-links">
            <span class="myflix-nav-section-title">Discover</span>

            <NavLink href="/category/new-releases" class="myflix-category-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4-6.3-4.6-6.3 4.6 2.3-7.4-6-4.6h7.6z"/>
                </svg>
                <span>New Releases</span>
            </NavLink>

            <NavLink href="/category/bl-series" class="myflix-category-link">
                <span class="myflix-badge-icon icon-pink">BL</span>
                <span>BL Series</span>
            </NavLink>

            <NavLink href="/category/korean-drama" class="myflix-category-link">
                <span class="myflix-badge-icon icon-violet">KR</span>
                <span>Korean Drama</span>
            </NavLink>

            <NavLink href="/category/movies" class="myflix-category-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2.5"></rect>
                    <line x1="2" y1="9" x2="22" y2="9"></line>
                    <line x1="7" y1="4" x2="7" y2="9"></line>
                    <line x1="12" y1="4" x2="12" y2="9"></line>
                    <line x1="17" y1="4" x2="17" y2="9"></line>
                </svg>
                <span>Movies &amp; Cinema</span>
            </NavLink>
        </div>

        @if (AuthService.IsAuthenticated() && (AuthService.IsAdmin() || AuthService.HasAnyPermission("Dashboard.View", "Content.View", "Episode.View", "User.View", "Role.View")))
        {
            <div class="myflix-divider"></div>
            <div class="myflix-category-links">
                <span class="myflix-nav-section-title">Management</span>
                <NavLink href="/admin" class="myflix-category-link admin-nav-pill">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Admin Portal</span>
                    <span class="nav-admin-chip">Portal</span>
                </NavLink>
            </div>
        }
    </div>

    <!-- Bottom Actions & User Profile -->
    <div class="myflix-bottom-nav">
        @if (AuthService.IsAuthenticated())
        {
            <!-- User Status Card in Sidebar -->
            <div class="nav-user-box">
                <div class="nav-user-avatar">
                    @(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "U" : AuthService.CurrentUser.DisplayName.Substring(0, 1).ToUpper())
                </div>
                <div class="nav-user-details">
                    <span class="nav-user-name">@AuthService.CurrentUser.DisplayName</span>
                    <span class="nav-user-role">@(AuthService.IsAdmin() ? "🛡 Admin" : "Member")</span>
                </div>
            </div>

            <button type="button" class="myflix-category-link logout-btn" @onclick="HandleLogout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Log Out</span>
            </button>
        }
        else
        {
            <NavLink href="/login" class="myflix-category-link login-nav-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Sign In</span>
            </NavLink>
        }
    </div>
</aside>

@code {
    private int WatchCount = 0;
    private int FavoriteCount = 0;

    protected override async Task OnInitializedAsync()
    {
        WatchLaterService.OnChange += HandleChange;
        FavoriteService.OnChange += HandleChange;
        AuthService.OnAuthStateChanged += HandleAuthChange;

        await RefreshCountsAsync();
    }

    private async Task RefreshCountsAsync()
    {
        WatchCount = await WatchLaterService.GetCountAsync();
        FavoriteCount = await FavoriteService.GetCountAsync();
    }

    private async void HandleChange()
    {
        await RefreshCountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleAuthChange()
    {
        await WatchLaterService.LoadItemsForActiveUserAsync();
        await FavoriteService.LoadFavoritesForActiveUserAsync();
        await RefreshCountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        WatchLaterService.OnChange -= HandleChange;
        FavoriteService.OnChange -= HandleChange;
        AuthService.OnAuthStateChanged -= HandleAuthChange;
    }
}
