@page "/watch-later"
@rendermode InteractiveServer

<PageTitle>Watch Later - NangWorld</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="wl-toast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>@ToastMessage</span>
    </div>
}

<!-- Top App Header -->
<header class="myflix-header">
    <div class="myflix-search-group">
        <div class="myflix-search-bar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7ea29a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search within Watch Later..." value="@SearchQuery" @oninput="OnSearchChanged" />
        </div>
    </div>

    <div class="myflix-header-right">
        <!-- Notification Bell -->
        <button class="myflix-notif-btn" aria-label="Notifications" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="myflix-notif-dot"></span>
        </button>

        <!-- User Profile Pill -->
        @if (AuthService.IsAuthenticated())
        {
            <div class="myflix-user-profile" title="@AuthService.CurrentUser.DisplayName (@AuthService.CurrentUser.Role)">
                <div class="myflix-avatar-text">
                    @(string.IsNullOrWhiteSpace(AuthService.CurrentUser.DisplayName) ? "U" : AuthService.CurrentUser.DisplayName.Substring(0, 1).ToUpper())
                </div>
                <span class="myflix-username">@AuthService.CurrentUser.DisplayName</span>
                @if (AuthService.IsAdmin())
                {
                    <span class="header-admin-badge">Admin</span>
                }
            </div>
        }
        else
        {
            <a href="/login" class="myflix-signin-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span>Sign In</span>
            </a>
        }
    </div>
</header>

@if (!AuthService.IsAuthenticated())
{
    <!-- Guest Authentication Gate Screen -->
    <div class="watch-guest-gate">
        <div class="watch-guest-card">
            <div class="watch-guest-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#DE7149" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <h2>Sign In to Access Your Watch Later</h2>
            <p>Your Watch Later queue is private and synchronized with your account in the database. Please sign in or register to bookmark and manage Asian dramas, BL series, and movies you want to watch.</p>
            <div class="watch-guest-actions">
                <a href="/login?returnUrl=/watch-later" class="watch-guest-btn-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    <span>Sign In to NangWorld</span>
                </a>
                <a href="/" class="watch-guest-btn-secondary">
                    <span>Browse Catalog as Guest</span>
                </a>
            </div>
        </div>
    </div>
}
else
{
    <!-- Watch Later Hero Header -->
    <div class="wl-hero">
    <div class="wl-hero-left">
        <div class="wl-hero-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>My Personal Queue</span>
        </div>
        <h1 class="wl-title">Watch Later</h1>
        <p class="wl-subtitle">Keep track of your saved Korean dramas, Thai series, and movies to enjoy anytime.</p>
    </div>

    <div class="wl-hero-stats">
        <div class="wl-stat-card">
            <span class="wl-stat-num">@CountAll</span>
            <span class="wl-stat-label">Saved Titles</span>
        </div>
        <div class="wl-stat-card">
            <span class="wl-stat-num">@CountWatching</span>
            <span class="wl-stat-label">In Progress</span>
        </div>
    </div>
</div>

<!-- Filter Tabs & Controls -->
<div class="wl-controls-bar">
    <div class="wl-filter-pills">
        <button type="button" class="wl-pill @(SelectedFilter == "All" ? "active" : "")" @onclick='() => SetFilter("All")'>
            All <span class="wl-pill-count">@CountAll</span>
        </button>
        <button type="button" class="wl-pill @(SelectedFilter == "Korean Drama" ? "active" : "")" @onclick='() => SetFilter("Korean Drama")'>
            Korean Drama <span class="wl-pill-count">@CountKorean</span>
        </button>
        <button type="button" class="wl-pill @(SelectedFilter == "Thai BL" ? "active" : "")" @onclick='() => SetFilter("Thai BL")'>
            Thai BL <span class="wl-pill-count">@CountThai</span>
        </button>
        <button type="button" class="wl-pill @(SelectedFilter == "Movies" ? "active" : "")" @onclick='() => SetFilter("Movies")'>
            Movies <span class="wl-pill-count">@CountMovies</span>
        </button>
        <button type="button" class="wl-pill @(SelectedFilter == "Watching" ? "active" : "")" @onclick='() => SetFilter("Watching")'>
            Watching <span class="wl-pill-count">@CountWatching</span>
        </button>
    </div>

    <div class="wl-sort-group">
        <label for="wl-sort" class="wl-sort-label">Sort by:</label>
        <select id="wl-sort" class="wl-sort-select" value="@SortBy" @onchange="OnSortChanged">
            <option value="recent">Recently Added</option>
            <option value="title">Title (A - Z)</option>
            <option value="episodes">Most Episodes</option>
        </select>
    </div>
</div>

<!-- Main Cards Grid -->
@if (IsLoading)
{
    <div class="wl-loading">
        <div class="wl-spinner"></div>
        <p>Loading your Watch Later queue...</p>
    </div>
}
else if (FilteredItems.Count == 0)
{
    <div class="wl-empty-state">
        <div class="wl-empty-icon-wrap">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
        </div>
        <h3>No titles found</h3>
        <p>
            @(string.IsNullOrWhiteSpace(SearchQuery) && SelectedFilter == "All"
                ? "Your Watch Later list is currently empty. Explore our catalog and click 'Add to Watchlist' to save dramas here."
                : "No saved titles match your current filter or search criteria.")
        </p>
        <button type="button" class="wl-btn-primary" @onclick="ExploreCatalog">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Explore Catalog</span>
        </button>
    </div>
}
else
{
    <div class="wl-grid">
        @foreach (var item in FilteredItems)
        {
            <article class="wl-card">
                <!-- Thumbnail & Overlay -->
                <div class="wl-card-poster-wrap" @onclick="() => NavigateToItem(item)">
                    <img src="@item.PosterUrl" alt="@item.Title" class="wl-card-poster" loading="lazy" />
                    
                    <div class="wl-poster-overlay">
                        <button type="button" class="wl-play-disc" title="Play Now">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="6 4 19 12 6 20 6 4"></polygon>
                            </svg>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(item.Category))
                    {
                        <span class="wl-cat-tag">@item.Category</span>
                    }

                    <span class="wl-ep-tag">
                        @(item.TotalEpisodes > 1 ? $"{item.TotalEpisodes} Eps" : "Movie")
                    </span>
                </div>

                <!-- Info Body -->
                <div class="wl-card-body">
                    <div class="wl-card-top-info">
                        <span class="wl-status-pill @(item.Status == "Watching" ? "watching" : "")">
                            @(item.Status == "Watching" ? "▶ In Progress" : "Want to Watch")
                        </span>
                        <span class="wl-added-date">@item.AddedAt.ToString("MMM dd")</span>
                    </div>

                    <h3 class="wl-card-title" title="@item.Title" @onclick="() => NavigateToItem(item)">
                        @item.Title
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="wl-card-desc">@item.Description</p>
                    }

                    <!-- Progress bar if watching -->
                    @if (item.Status == "Watching" && item.TotalEpisodes > 1)
                    {
                        var pct = Math.Min(100, Math.Max(10, (int)((double)item.CurrentEpisode / item.TotalEpisodes * 100)));
                        <div class="wl-progress-box">
                            <div class="wl-progress-bar">
                                <div class="wl-progress-fill" style="width: @(pct)%"></div>
                            </div>
                            <span class="wl-progress-text">Ep @item.CurrentEpisode of @item.TotalEpisodes</span>
                        </div>
                    }

                    <!-- Card Actions -->
                    <div class="wl-card-actions">
                        <button type="button" class="wl-btn-watch" @onclick="() => NavigateToItem(item)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="6 4 19 12 6 20 6 4"></polygon>
                            </svg>
                            <span>Watch</span>
                        </button>

                        <button type="button" class="wl-btn-remove" title="Remove from Watch Later" @onclick="() => RemoveItem(item)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}
}
