@page "/category/{CategorySlug}"
@page "/category"
@rendermode InteractiveServer

<PageTitle>@CategoryTitle - NangWorld</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="cat-toast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#DE7149" stroke="#DE7149" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span>@ToastMessage</span>
    </div>
}

<!-- Top App Header -->
<header class="myflix-header">
    <div class="myflix-search-group">
        <div class="myflix-search-bar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7ea29a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search within @CategoryTitle..." value="@SearchQuery" @oninput="OnSearchChanged" />
        </div>
    </div>

    <div class="myflix-header-right">
        <!-- Notification Bell -->
        <button class="myflix-notif-btn" aria-label="Notifications" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="myflix-notif-dot"></span>
        </button>

        <!-- User Profile Pill -->
        <div class="myflix-user-profile">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="May Zin" class="myflix-avatar" />
            <span class="myflix-username">May Zin</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </div>
</header>

<!-- Category Hero Banner -->
<div class="cat-hero">
    <div class="cat-hero-left">
        <div class="cat-hero-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>@CategoryBadge</span>
        </div>
        <h1 class="cat-title">@CategoryTitle</h1>
        <p class="cat-subtitle">@CategorySubtitle</p>
    </div>

    <div class="cat-hero-stats">
        <div class="cat-stat-card">
            <span class="cat-stat-num">@FilteredItems.Count</span>
            <span class="cat-stat-label">Titles Available</span>
        </div>
        <div class="cat-stat-card">
            <span class="cat-stat-num">HD 1080p</span>
            <span class="cat-stat-label">Stream Quality</span>
        </div>
    </div>
</div>

<!-- Category Switcher Pills & Controls -->
<div class="cat-controls-bar">
    <div class="cat-filter-pills">
        <button type="button" class="cat-pill @(CurrentSlug == "new-releases" ? "active" : "")" @onclick='() => SetCategory("new-releases")'>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>New Releases</span>
        </button>

        <button type="button" class="cat-pill @(CurrentSlug == "bl-series" || CurrentSlug == "thai-bl" ? "active" : "")" @onclick='() => SetCategory("bl-series")'>
            <span class="cat-mini-badge">BL</span>
            <span>BL Series</span>
        </button>

        <button type="button" class="cat-pill @(CurrentSlug == "korean-drama" ? "active" : "")" @onclick='() => SetCategory("korean-drama")'>
            <span class="cat-mini-badge">KR</span>
            <span>Korean Drama</span>
        </button>

        <button type="button" class="cat-pill @(CurrentSlug == "movies" ? "active" : "")" @onclick='() => SetCategory("movies")'>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <rect x="2" y="4" width="20" height="16" rx="2.5"></rect>
                <line x1="2" y1="9" x2="22" y2="9"></line>
            </svg>
            <span>Movies</span>
        </button>
    </div>

    <div class="cat-sort-group">
        <label for="cat-sort" class="cat-sort-label">Sort by:</label>
        <select id="cat-sort" class="cat-sort-select" value="@SortBy" @onchange="OnSortChanged">
            <option value="rating">Highest Rated</option>
            <option value="year">Latest Release</option>
            <option value="title">Title (A - Z)</option>
        </select>
    </div>
</div>

<!-- Main Category Grid -->
@if (IsLoading)
{
    <div class="cat-loading">
        <div class="cat-spinner"></div>
        <p>Loading @CategoryTitle catalog...</p>
    </div>
}
else if (FilteredItems.Count == 0)
{
    <div class="cat-empty-state">
        <div class="cat-empty-icon-wrap">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        <h3>No titles found</h3>
        <p>
            @(string.IsNullOrWhiteSpace(SearchQuery)
                ? $"No titles currently available under {CategoryTitle}."
                : $"No results found for \"{SearchQuery}\" in {CategoryTitle}.")
        </p>
        <button type="button" class="cat-btn-primary" @onclick='() => Nav.NavigateTo("/")'>
            <span>Return to Home</span>
        </button>
    </div>
}
else
{
    <div class="cat-poster-grid">
        @foreach (var item in FilteredItems)
        {
            <article class="cat-poster-card" @onclick="() => NavigateToItem(item)">
                <div class="cat-poster-thumb-wrap">
                    <img src="@item.PosterUrl" alt="@item.Title" class="cat-poster-img" loading="lazy" />

                    <!-- Hover Play Overlay -->
                    <div class="cat-poster-overlay">
                        <button type="button" class="cat-play-disc" title="Watch Now">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="6 4 19 12 6 20 6 4"></polygon>
                            </svg>
                        </button>
                    </div>

                    <!-- Heart Favorite Button top-right -->
                    <button type="button"
                            class="cat-card-heart @(FavoriteIds.Contains(item.Id) ? "active" : "")"
                            title="@(FavoriteIds.Contains(item.Id) ? "Remove from Favorites" : "Add to Favorites")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavorite(item)">
                        <svg width="15" height="15" viewBox="0 0 24 24"
                             fill="@(FavoriteIds.Contains(item.Id) ? "#DE7149" : "none")"
                             stroke="@(FavoriteIds.Contains(item.Id) ? "#DE7149" : "currentColor")"
                             stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>

                    <!-- Rating Tag top-left -->
                    <span class="cat-rating-tag">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>@item.Rating.ToString("0.0")</span>
                    </span>

                    <!-- Episode / Category Tag bottom-right -->
                    <span class="cat-ep-tag">
                        @(item.TotalEpisodes > 1 ? $"{item.TotalEpisodes} Eps" : "Movie")
                    </span>
                </div>

                <!-- Info footer -->
                <div class="cat-poster-info">
                    <div class="cat-poster-meta">
                        <span class="cat-meta-year">@item.Year</span>
                        <span class="cat-meta-badge">@item.Category</span>
                    </div>
                    <h3 class="cat-poster-title" title="@item.Title">@item.Title</h3>
                </div>
            </article>
        }
    </div>
}
