@page "/admin/episodes"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@using DotNetProject.Domain.Features.Contents
@using DotNetProject.Database.AppDbModels
@rendermode InteractiveServer
@inject HttpClientService ApiClient
@inject NavigationManager Nav
@inject AppDbContext Db

<PageTitle>Episodes Management — NangWorld Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Episodes Management</h1>
        <p>Browse, manage and stream drama episodes stored in database &amp; D: drive.</p>
    </div>
    <div class="admin-header-actions">
        <a href="admin/contents" class="btn-admin btn-admin-edit">
            ← Back to Dramas
        </a>
    </div>
</div>

<div class="admin-content-area">
    <!-- Drama Selector Bar -->
    <div class="admin-card" style="padding:1.2rem 1.4rem;">
        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
            <label style="font-weight:700;font-size:0.9rem;color:#285843;">Select Drama:</label>
            <select class="admin-select" style="min-width:260px;" value="@SelectedContentId" @onchange="OnDramaChange">
                @foreach (var d in DramaList)
                {
                    <option value="@d.ContentId">@d.Title</option>
                }
            </select>
            <button class="btn-admin btn-admin-primary" @onclick="() => LoadDramaEpisodesAsync(SelectedContentId)">
                Load Episodes
            </button>
            <span style="font-size:0.85rem;color:#5F7961;margin-left:auto;">
                Total Episodes: <strong>@Episodes.Count</strong>
            </span>
        </div>
    </div>

    <!-- Active Video Player Preview (if an episode is selected) -->
    @if (CurrentPlayingEpisode != null)
    {
        <div class="admin-card" style="padding:1.4rem;border-left:4px solid #418F6B;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <div>
                    <h3 style="margin:0;font-size:1.15rem;color:#1F4233;font-weight:700;">
                        ▶ Now Streaming: @CurrentPlayingEpisode.Title
                    </h3>
                    <p style="margin:4px 0 0;font-size:0.85rem;color:#5F7961;">
                        Episode @CurrentPlayingEpisode.EpisodeNumber · Duration: @(CurrentPlayingEpisode.Duration)m · Status: @CurrentPlayingEpisode.Status
                    </p>
                </div>
                <button class="btn-admin btn-admin-delete" style="font-size:0.8rem;padding:0.3rem 0.6rem;" @onclick="ClosePlayer">
                    ✕ Close Player
                </button>
            </div>
            <div style="max-width:800px;border-radius:12px;overflow:hidden;background:#000;box-shadow:0 4px 15px rgba(0,0,0,0.2);">
                <video src="@CurrentPlayingEpisode.VideoUrl" controls autoplay style="width:100%;max-height:450px;display:block;">
                    Your browser does not support the video tag.
                </video>
            </div>
            @if (!string.IsNullOrWhiteSpace(CurrentPlayingEpisode.Description))
            {
                <p style="margin:12px 0 0;font-size:0.85rem;color:#4A483E;background:#F4FAF6;padding:10px 14px;border-radius:8px;">
                    <strong>Synopsis:</strong> @CurrentPlayingEpisode.Description
                </p>
            }
        </div>
    }

    <!-- Table Card -->
    <div class="admin-card">
        @if (IsLoading)
        {
            <div class="admin-loading">Loading episodes from database...</div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="admin-alert admin-alert-error" style="margin:1rem 1.4rem;">@ErrorMessage</div>
        }
        else if (Episodes.Count == 0)
        {
            <div class="admin-empty">
                No episodes found for this drama in the database.
            </div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">Ep #</th>
                            <th style="width:80px;">Thumbnail</th>
                            <th>Episode Title</th>
                            <th>Duration</th>
                            <th>Video URL / Local File</th>
                            <th>Status</th>
                            <th style="width:140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ep in Episodes)
                        {
                            bool isCurrent = CurrentPlayingEpisode?.EpisodeId == ep.EpisodeId;
                            <tr style="@(isCurrent ? "background:rgba(204,233,220,0.35);" : "")">
                                <td style="font-weight:700;color:#285843;text-align:center;">
                                    @ep.EpisodeNumber
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ep.ThumbnailUrl))
                                    {
                                        <img src="@ep.ThumbnailUrl" alt="Thumbnail" class="admin-thumb" style="width:48px;height:48px;object-fit:cover;border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <div class="admin-no-thumb" style="width:48px;height:48px;line-height:48px;text-align:center;">EP</div>
                                    }
                                </td>
                                <td>
                                    <div class="admin-title-cell" style="font-weight:600;">@ep.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(ep.Description))
                                    {
                                        <div class="admin-sub-cell" style="max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:0.75rem;color:#7B977D;">
                                            @ep.Description
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span style="font-size:0.8rem;color:#327255;font-weight:600;">
                                        @(ep.Duration.HasValue ? $"{ep.Duration}m" : "-")
                                    </span>
                                </td>
                                <td>
                                    <code style="font-size:0.75rem;background:#F4FAF6;color:#1F4233;padding:3px 6px;border-radius:4px;border:1px solid #CCE9DC;word-break:break-all;">
                                        @ep.VideoUrl
                                    </code>
                                </td>
                                <td>
                                    <span class="badge badge-active" style="font-size:0.7rem;padding:3px 8px;">
                                        @ep.Status
                                    </span>
                                </td>
                                <td style="white-space: nowrap;">
                                    <button class="btn-admin btn-admin-primary" style="padding:0.35rem 0.65rem;font-size:0.8rem;display:inline-flex;align-items:center;gap:4px;" @onclick="() => PlayEpisode(ep)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                        </svg>
                                        Play
                                    </button>
                                    <button class="btn-admin btn-admin-edit" style="padding:0.35rem 0.65rem;font-size:0.8rem;display:inline-flex;align-items:center;gap:4px;margin-left:4px;" @onclick="() => EditEpisode(ep)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        Edit URL
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Edit Episode Video URL Modal -->
    @if (EditingEpisode != null)
    {
        <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.65);backdrop-filter:blur(4px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;">
            <div style="background:#FFFFFF;border-radius:18px;max-width:540px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,0.3);overflow:hidden;border:1px solid #CCE9DC;">
                <div style="padding:16px 22px;background:#F4FAF6;border-bottom:1px solid #CCE9DC;display:flex;align-items:center;justify-content:space-between;">
                    <h3 style="margin:0;font-size:16px;color:#1F4233;font-weight:700;">
                        ✏ Edit Episode @EditingEpisode.EpisodeNumber Video & Info
                    </h3>
                    <button type="button" @onclick="CloseEditModal" style="border:none;background:transparent;cursor:pointer;font-size:18px;color:#7B977D;">✕</button>
                </div>

                <div style="padding:22px;display:flex;flex-direction:column;gap:14px;">
                    @if (!string.IsNullOrEmpty(EditSuccessMessage))
                    {
                        <div style="padding:10px 14px;border-radius:8px;background:rgba(16,185,129,0.12);color:#10B981;font-size:13px;font-weight:600;">
                            @EditSuccessMessage
                        </div>
                    }

                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#285843;margin-bottom:6px;">Video URL / Stream Link <span style="color:#DE7149;">*</span></label>
                        <input type="text" class="admin-input" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #CCE9DC;font-size:13px;"
                               @bind="EditVideoUrl" placeholder="e.g. /videos/... or https://www.youtube.com/embed/... or direct .mp4" />
                        <span style="font-size:11.5px;color:#7B977D;margin-top:4px;display:block;">
                            Supports YouTube embed links, local D:\ files (/videos/...), or online direct MP4 streams.
                        </span>
                    </div>

                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#285843;margin-bottom:6px;">Episode Title</label>
                        <input type="text" class="admin-input" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #CCE9DC;font-size:13px;"
                               @bind="EditTitle" placeholder="Episode title" />
                    </div>

                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#285843;margin-bottom:6px;">Episode Synopsis / Description</label>
                        <textarea class="admin-input" rows="3" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #CCE9DC;font-size:13px;"
                                  @bind="EditDescription" placeholder="Short description of this episode..."></textarea>
                    </div>

                    <div>
                        <label style="display:block;font-size:13px;font-weight:700;color:#285843;margin-bottom:6px;">Thumbnail URL</label>
                        <input type="text" class="admin-input" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #CCE9DC;font-size:13px;"
                               @bind="EditThumbnailUrl" placeholder="https://..." />
                    </div>
                </div>

                <div style="padding:14px 22px;background:#F8FAF9;border-top:1px solid #CCE9DC;display:flex;justify-content:flex-end;gap:10px;">
                    <button type="button" class="btn-admin btn-admin-edit" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="btn-admin btn-admin-primary" @onclick="SaveEpisodeChangesAsync" disabled="@IsSavingEpisode">
                        @(IsSavingEpisode ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public long? ContentId { get; set; }

    private long SelectedContentId = 23; // Defaults to Alchemy of Souls
    private List<ContentListItemResponse> DramaList = new();
    private List<EpisodeDto> Episodes = new();
    private EpisodeDto? CurrentPlayingEpisode;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (ContentId.HasValue && ContentId.Value > 0)
        {
            SelectedContentId = ContentId.Value;
        }

        await LoadDramaListAsync();
        await LoadDramaEpisodesAsync(SelectedContentId);
    }

    private async Task LoadDramaListAsync()
    {
        var result = await ApiClient.GetContentsPagedAsync(new GetContentPagedListRequest
        {
            PageNo = 1,
            PageSize = 50,
            ContentTypeId = 2 // Dramas
        });

        if (result != null && result.IsSuccess && result.Data?.Items != null)
        {
            DramaList = result.Data.Items.ToList();
            if (!DramaList.Any(d => d.ContentId == SelectedContentId) && DramaList.Any())
            {
                SelectedContentId = DramaList.First().ContentId;
            }
        }
    }

    private async Task OnDramaChange(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            SelectedContentId = id;
            await LoadDramaEpisodesAsync(id);
        }
    }

    private async Task LoadDramaEpisodesAsync(long contentId)
    {
        IsLoading = true;
        ErrorMessage = null;
        CurrentPlayingEpisode = null;

        var result = await ApiClient.GetContentWithEpisodesAsync(contentId);
        IsLoading = false;

        if (result == null || !result.IsSuccess || result.Data == null)
        {
            ErrorMessage = result?.Message ?? "Failed to load episodes from database.";
            Episodes = new();
            return;
        }

        Episodes = result.Data.Episodes?.OrderBy(x => x.EpisodeNumber).ToList() ?? new();
    }

    private void PlayEpisode(EpisodeDto ep)
    {
        CurrentPlayingEpisode = ep;
    }

    private void ClosePlayer()
    {
        CurrentPlayingEpisode = null;
    }

    private EpisodeDto? EditingEpisode;
    private string EditVideoUrl = "";
    private string EditTitle = "";
    private string EditDescription = "";
    private string EditThumbnailUrl = "";
    private string? EditSuccessMessage;
    private bool IsSavingEpisode = false;

    private void EditEpisode(EpisodeDto ep)
    {
        EditingEpisode = ep;
        EditVideoUrl = ep.VideoUrl ?? "";
        EditTitle = ep.Title ?? "";
        EditDescription = ep.Description ?? "";
        EditThumbnailUrl = ep.ThumbnailUrl ?? "";
        EditSuccessMessage = null;
    }

    private void CloseEditModal()
    {
        EditingEpisode = null;
        EditSuccessMessage = null;
    }

    private async Task SaveEpisodeChangesAsync()
    {
        if (EditingEpisode == null) return;

        IsSavingEpisode = true;
        EditSuccessMessage = null;

        try
        {
            var dbEpisode = await Db.Episodes.FindAsync(EditingEpisode.EpisodeId);
            if (dbEpisode != null)
            {
                dbEpisode.VideoUrl = EditVideoUrl.Trim();
                dbEpisode.Title = EditTitle.Trim();
                dbEpisode.Description = EditDescription.Trim();
                dbEpisode.ThumbnailUrl = EditThumbnailUrl.Trim();
                dbEpisode.UpdatedAt = DateTime.UtcNow;

                await Db.SaveChangesAsync();

                EditingEpisode.VideoUrl = dbEpisode.VideoUrl;
                EditingEpisode.Title = dbEpisode.Title;
                EditingEpisode.Description = dbEpisode.Description;
                EditingEpisode.ThumbnailUrl = dbEpisode.ThumbnailUrl;

                EditSuccessMessage = "Saved successfully!";
                await Task.Delay(500);
                CloseEditModal();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to update episode: " + ex.Message;
        }
        finally
        {
            IsSavingEpisode = false;
        }
    }
}
