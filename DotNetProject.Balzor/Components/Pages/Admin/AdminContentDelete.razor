@page "/admin/contents/delete/{Id:long}"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@rendermode InteractiveServer

<PageTitle>Delete Drama — SereneFlix Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Delete Drama / Series</h1>
        <p><a href="/admin/contents" style="color:#7B977D;text-decoration:none;">← Back to Dramas</a></p>
    </div>
</div>

<div class="admin-content-area">
    @if (_loading) { <div class="admin-loading">Loading…</div> }
    else if (_loadError != null) { <div class="admin-alert admin-alert-error">@_loadError</div> }
    else
    {
        @if (_error != null) { <div class="admin-alert admin-alert-error">@_error</div> }

        <div class="admin-form-card" style="max-width:480px;text-align:center;">
            <div style="width:56px;height:56px;border-radius:14px;background:#F9ECEC;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D99898" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                    <path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
            </div>
            <h2 style="font-size:1.2rem;color:#232C24;margin:0 0 .5rem;">Delete "@_title"?</h2>
            <p style="font-size:.85rem;color:#7B977D;margin:0 0 1.5rem;">
                This will permanently remove this drama and all its episodes from the database. This cannot be undone.
            </p>
            <div style="display:flex;gap:.75rem;justify-content:center;">
                <a href="/admin/contents" class="btn-admin btn-admin-edit">Cancel</a>
                <button class="btn-admin btn-admin-delete" style="background:#D99898;color:white;" @onclick="ConfirmDelete" disabled="@_deleting">
                    @(_deleting ? "Deleting…" : "Yes, Delete")
                </button>
            </div>
        </div>
    }
</div>
