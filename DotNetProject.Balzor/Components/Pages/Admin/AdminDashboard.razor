@page "/admin"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Admin Dashboard — NangWorld</PageTitle>

<!-- Page Header -->
<div class="admin-page-header">
    <div>
        <h1>Dashboard Overview</h1>
        <p>Welcome back, Admin. Here's what's happening today.</p>
    </div>
    <div class="admin-header-actions">
        <a href="admin/movies/create" class="btn-admin btn-admin-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Content
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="admin-stat-grid">
    <a class="admin-stat-card" href="admin/movies">
        <div class="admin-stat-top">
            <div class="admin-stat-icon mint">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2.5"/>
                    <line x1="2" y1="9" x2="22" y2="9"/>
                    <line x1="7" y1="4" x2="7" y2="9"/>
                    <line x1="12" y1="4" x2="12" y2="9"/>
                    <line x1="17" y1="4" x2="17" y2="9"/>
                </svg>
            </div>
            <span class="admin-stat-chip mint">Movies</span>
        </div>
        <div class="admin-stat-value">@(_movieCount > 0 ? _movieCount.ToString() : "—")</div>
        <div class="admin-stat-label">Total Movies</div>
        <div class="admin-stat-bar"><div class="admin-stat-bar-fill mint" style="width:70%"></div></div>
    </a>

    <a class="admin-stat-card" href="admin/contents">
        <div class="admin-stat-top">
            <div class="admin-stat-icon sage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                </svg>
            </div>
            <span class="admin-stat-chip sage">Dramas</span>
        </div>
        <div class="admin-stat-value">@(_contentCount > 0 ? _contentCount.ToString() : "—")</div>
        <div class="admin-stat-label">Dramas &amp; Series</div>
        <div class="admin-stat-bar"><div class="admin-stat-bar-fill sage" style="width:50%"></div></div>
    </a>

    <a class="admin-stat-card" href="admin/users">
        <div class="admin-stat-top">
            <div class="admin-stat-icon blush">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <span class="admin-stat-chip blush">Users</span>
        </div>
        <div class="admin-stat-value">@(_userCount > 0 ? _userCount.ToString() : "—")</div>
        <div class="admin-stat-label">Registered Users</div>
        <div class="admin-stat-bar"><div class="admin-stat-bar-fill blush" style="width:80%"></div></div>
    </a>

    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon honey">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
            </div>
            <span class="admin-stat-chip honey">Rating</span>
        </div>
        <div class="admin-stat-value">9.1</div>
        <div class="admin-stat-label">Avg. Content Rating</div>
        <div class="admin-stat-bar"><div class="admin-stat-bar-fill honey" style="width:91%"></div></div>
    </div>
</div>

<!-- Dashboard Grid: Recent Movies + Quick Actions -->
<div class="admin-dash-grid">
    <!-- Recent Movies Table -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2>Recent Movies</h2>
                <p>Latest entries in the system</p>
            </div>
            <a href="admin/movies" class="btn-admin btn-admin-edit" style="font-size:.78rem">View all →</a>
        </div>

        @if (_loading)
        {
            <div class="admin-loading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation:spin 1s linear infinite">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
                Loading…
            </div>
        }
        else if (_recentMovies.Count == 0)
        {
            <div class="admin-empty">No movies found. <a href="admin/movies/create" style="color:var(--brand-terracotta);font-weight:700;">Add one →</a></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Poster</th>
                            <th>Title</th>
                            <th>Year</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _recentMovies)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(m.PosterUrl))
                                    {
                                        <img src="@m.PosterUrl" alt="@m.Title" class="admin-thumb" />
                                    }
                                    else
                                    {
                                        <div class="admin-no-thumb">—</div>
                                    }
                                </td>
                                <td>
                                    <div class="admin-title-cell">@m.Title</div>
                                </td>
                                <td class="admin-sub-cell">@(m.ReleaseYear?.ToString() ?? "—")</td>
                                <td>
                                    <a href="/admin/movies/edit/@m.Id" class="btn-admin btn-admin-edit">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Quick Actions + System Info -->
    <div style="display:flex;flex-direction:column;gap:1.1rem;">
        <div class="admin-card">
            <div class="admin-card-header">
                <div><h2>Quick Actions</h2></div>
            </div>
            <div style="padding:1rem;display:flex;flex-direction:column;gap:.55rem;">
                <a href="/admin/movies/create" class="btn-admin btn-admin-primary" style="justify-content:center">
                    🎬 Add New Movie
                </a>
                <a href="/admin/contents/create" class="btn-admin btn-admin-edit" style="justify-content:center">
                    📺 Add Drama / Series
                </a>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div><h2>System Info</h2></div>
            </div>
            <div style="padding:1rem;display:flex;flex-direction:column;gap:.6rem;font-size:.82rem;color:#485C4A;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="color:#7B977D;">API Status</span>
                    <span class="badge badge-active">Online</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="color:#7B977D;">Storage</span>
                    <span class="badge badge-active">Healthy</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="color:#7B977D;">Environment</span>
                    <span class="badge badge-upcoming">Development</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
