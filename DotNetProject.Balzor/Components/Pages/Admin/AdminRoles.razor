@page "/admin/roles"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Layout
@using DotNetProject.Balzor.Components.Shared
@rendermode InteractiveServer

<PageTitle>Dynamic Roles &amp; Permissions — NangWorld Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Dynamic Roles &amp; Permissions</h1>
        <p>Define granular access roles, customize module permissions, and control administrative authorization in real-time.</p>
    </div>
    <div class="admin-header-actions">
        @if (AuthService.HasPermission("Role.Manage"))
        {
            <button type="button" class="btn-admin btn-admin-primary" @onclick="OpenCreateModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Create New Role
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="user-alert success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>@SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="user-alert error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@ErrorMessage</span>
    </div>
}

<!-- Claymorphic Stats Overview -->
<div class="admin-stat-grid" style="margin-bottom: 24px;">
    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon honey">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span class="admin-stat-chip honey">Total Roles</span>
        </div>
        <div class="admin-stat-value">@RolesList.Count</div>
        <div class="admin-stat-label">Defined in SQL Server</div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon sage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="admin-stat-chip sage">Active Roles</span>
        </div>
        <div class="admin-stat-value">@RolesList.Count(r => r.IsActive)</div>
        <div class="admin-stat-label">Usable by members</div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon blush">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <span class="admin-stat-chip blush">Permissions Catalog</span>
        </div>
        <div class="admin-stat-value">@AllPermissions.Count</div>
        <div class="admin-stat-label">Across 5 modules</div>
    </div>
</div>

<!-- Roles Table Card -->
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
            <span>Configured Roles &amp; Access Scope</span>
        </div>
        <button type="button" class="btn-admin btn-admin-secondary" @onclick="LoadDataAsync">
            Refresh
        </button>
    </div>

    @if (IsLoading)
    {
        <div style="padding: 40px; text-align: center; color: #7A908A;">
            <p>Loading dynamic roles and permissions...</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 180px;">Role Name</th>
                        <th>Description</th>
                        <th style="width: 120px;">Type</th>
                        <th style="width: 100px;">Assigned Users</th>
                        <th>Permissions Scope</th>
                        <th style="width: 140px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in RolesList)
                    {
                        <tr>
                            <td>
                                <strong style="font-size: 14px; color: #183B36;">@role.RoleName</strong>
                            </td>
                            <td>
                                <span style="font-size: 13px; color: #5C6B64;">@(role.Description ?? "No description provided.")</span>
                            </td>
                            <td>
                                @if (role.IsSystemRole)
                                {
                                    <span class="chip chip-gold" title="Built-in protected system role">System</span>
                                }
                                else
                                {
                                    <span class="chip chip-purple" title="Custom dynamic role">Custom</span>
                                }
                            </td>
                            <td>
                                <span class="chip chip-blue">@role.UserCount user(s)</span>
                            </td>
                            <td>
                                @if (role.RoleName == "SuperAdmin")
                                {
                                    <span class="chip chip-gold" style="font-weight: 700;">★ Full System Access (All)</span>
                                }
                                else
                                {
                                    <div style="display: flex; gap: 4px; flex-wrap: wrap; max-width: 380px;">
                                        @foreach (var pCode in role.PermissionCodes.Take(4))
                                        {
                                            <span class="chip chip-gray" style="font-size: 11px;">@pCode</span>
                                        }
                                        @if (role.PermissionCodes.Count > 4)
                                        {
                                            <span class="chip chip-gold" style="font-size: 11px;">+@(role.PermissionCodes.Count - 4) more</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px;">
                                    @if (AuthService.HasPermission("Role.Manage"))
                                    {
                                        <button type="button" class="action-btn edit" @onclick="() => OpenEditModal(role)" title="Configure Permissions">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                        </button>
                                        @if (!role.IsSystemRole)
                                        {
                                            <button type="button" class="action-btn delete" @onclick="() => DeleteRoleAsync(role)" title="Delete Role">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Claymorphic Create/Edit Role Modal -->
@if (ShowEditModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(6px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: #FFFFFF; border-radius: 28px; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; padding: 28px 32px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), inset 2px 2px 5px rgba(255, 255, 255, 0.9); border: 2px solid rgba(222, 113, 73, 0.2); position: relative;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.3rem; color: #183B36; font-weight: 800;">@ModalTitle</h3>
                <button type="button" @onclick="CloseModal" style="background: none; border: none; font-size: 1.6rem; color: #7A908A; cursor: pointer;">&times;</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #183B36; margin-bottom: 6px;">Role Name *</label>
                    <input type="text" @bind="CurrentRoleRequest.RoleName" class="form-control" placeholder="e.g. ContentModerator" style="width: 100%; box-sizing: border-box; background: #F4EFEA; border: 1.5px solid rgba(24, 59, 54, 0.15); border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 600;" />
                </div>

                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #183B36; margin-bottom: 6px;">Description</label>
                    <input type="text" @bind="CurrentRoleRequest.Description" class="form-control" placeholder="Brief description of responsibilities" style="width: 100%; box-sizing: border-box; background: #F4EFEA; border: 1.5px solid rgba(24, 59, 54, 0.15); border-radius: 12px; padding: 10px 14px; font-size: 14px;" />
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="roleActiveCheck" @bind="CurrentRoleRequest.IsActive" style="width: 18px; height: 18px; cursor: pointer;" />
                    <label for="roleActiveCheck" style="font-size: 14px; font-weight: 600; color: #183B36; cursor: pointer;">Role is Active</label>
                </div>

                <hr style="border: none; border-top: 1px solid rgba(0,0,0,0.08); margin: 8px 0;" />

                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <label style="font-size: 14px; font-weight: 800; color: #183B36; margin: 0;">Granular Permissions Matrix</label>
                        <span style="font-size: 12px; color: #DE7149; font-weight: 700;">@SelectedPermissionIds.Count permission(s) granted</span>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        @foreach (var group in GroupedPermissions)
                        {
                            <div style="background: #F9F6F2; border: 1.5px solid rgba(24, 59, 54, 0.1); border-radius: 16px; padding: 14px 18px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.06); padding-bottom: 6px;">
                                    <strong style="color: #DE7149; font-size: 13.5px; text-transform: uppercase; letter-spacing: 0.5px;">@group.Key Module</strong>
                                    <div style="display: flex; gap: 8px;">
                                        <button type="button" @onclick="() => ToggleModuleAll(group.Key, true)" style="background: none; border: none; color: #2AABEE; font-size: 12px; font-weight: 600; cursor: pointer; padding: 0;">Select All</button>
                                        <span style="color: #CCC;">|</span>
                                        <button type="button" @onclick="() => ToggleModuleAll(group.Key, false)" style="background: none; border: none; color: #999; font-size: 12px; font-weight: 600; cursor: pointer; padding: 0;">Clear</button>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px;">
                                    @foreach (var perm in group)
                                    {
                                        var isChecked = SelectedPermissionIds.Contains(perm.PermissionId);
                                        <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #183B36; cursor: pointer; padding: 6px 8px; border-radius: 8px; background: @(isChecked ? "rgba(222, 113, 73, 0.08)" : "transparent");">
                                            <input type="checkbox" checked="@isChecked" @onchange="() => TogglePermission(perm.PermissionId)" style="margin-top: 2px; cursor: pointer;" />
                                            <div>
                                                <strong style="display: block; font-size: 12.5px;">@perm.PermissionCode</strong>
                                                <span style="font-size: 11px; color: #7A908A;">@perm.PermissionName</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 16px;">
                <button type="button" class="btn-admin btn-admin-secondary" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-admin btn-admin-primary" @onclick="SaveRoleAsync" disabled="@IsSaving">
                    @(IsSaving ? "Saving Role..." : "Save Role & Permissions")
                </button>
            </div>
        </div>
    </div>
}
