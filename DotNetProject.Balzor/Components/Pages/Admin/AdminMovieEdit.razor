@page "/admin/movies/edit/{Id:int}"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@rendermode InteractiveServer

<PageTitle>Edit Movie — NangWorld Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Edit Movie</h1>
        <p><a href="/admin/movies" style="color:#6B5B95;text-decoration:none;">← Back to Movies</a></p>
    </div>
</div>

<div class="admin-content-area">
    @if (_loading)
    {
        <div class="admin-loading">Loading movie…</div>
    }
    else if (_loadError != null)
    {
        <div class="admin-alert admin-alert-error">@_loadError</div>
    }
    else
    {
        @if (_success != null)
        {
            <div class="admin-alert admin-alert-success">@_success</div>
        }
        @if (_error != null)
        {
            <div class="admin-alert admin-alert-error">@_error</div>
        }

        <AdminMovieFormFields Model="_form"
                              TitleError="@_titleError"
                              SubmitLabel="Update Movie"
                              Submitting="@_submitting"
                              OnSubmit="SubmitAsync"
                              DeleteHref="@($"/admin/movies/delete/{Id}")" />
    }
</div>
