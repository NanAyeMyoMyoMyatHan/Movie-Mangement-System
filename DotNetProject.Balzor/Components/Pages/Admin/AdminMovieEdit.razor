@page "/admin/movies/edit/{Id:int}"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@rendermode InteractiveServer

<PageTitle>Edit Movie — SereneFlix Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Edit Movie</h1>
        <p><a href="/admin/movies" style="color:#7B977D;text-decoration:none;">← Back to Movies</a></p>
    </div>
</div>

<div class="admin-content-area">
    @if (_loading)
    {
        <div class="admin-loading">Loading movie…</div>
    }
    else if (_loadError != null)
    {
        <div class="admin-alert admin-alert-error">@_loadError</div>
    }
    else
    {
        @if (_success != null)
        {
            <div class="admin-alert admin-alert-success">@_success</div>
        }
        @if (_error != null)
        {
            <div class="admin-alert admin-alert-error">@_error</div>
        }

        <div class="admin-form-card">
            <div class="admin-form-group">
                <label class="admin-label">Title <span class="required">*</span></label>
                <input class="admin-input @(string.IsNullOrWhiteSpace(_titleError) ? "" : "input-error")"
                       @bind="_form.Title" placeholder="Movie title" />
                @if (!string.IsNullOrWhiteSpace(_titleError))
                {
                    <span class="admin-field-error">@_titleError</span>
                }
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-label">Genre</label>
                    <input class="admin-input" @bind="_form.Genre" placeholder="e.g. Romance, Action" />
                </div>
                <div class="admin-form-group">
                    <label class="admin-label">Release Year</label>
                    <input class="admin-input" type="number" @bind="_form.ReleaseYear" placeholder="e.g. 2024" />
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-label">Description</label>
                <textarea class="admin-input admin-textarea" @bind="_form.Description" rows="4" placeholder="Short synopsis…"></textarea>
            </div>

            <div class="admin-form-group">
                <label class="admin-label">Poster URL</label>
                <input class="admin-input" @bind="_form.PosterUrl" placeholder="https://…" />
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-label">TMDB ID</label>
                    <input class="admin-input" type="number" @bind="_form.TmdbId" placeholder="Optional" />
                </div>
                <div class="admin-form-group" style="justify-content:flex-end;padding-bottom:.2rem;">
                    <label style="display:flex;align-items:center;gap:.5rem;font-size:.84rem;color:#485C4A;cursor:pointer;">
                        <input type="checkbox" @bind="_form.IsManual" /> Manual entry
                    </label>
                </div>
            </div>

            <div class="admin-form-actions">
                <button class="btn-admin btn-admin-primary" @onclick="SubmitAsync" disabled="@_submitting">
                    @(_submitting ? "Saving…" : "Update Movie")
                </button>
                <a href="/admin/movies" class="btn-admin btn-admin-edit">Cancel</a>
                <a href="/admin/movies/delete/@Id" class="btn-admin btn-admin-delete" style="margin-left:auto;">Delete</a>
            </div>
        </div>
    }
</div>
