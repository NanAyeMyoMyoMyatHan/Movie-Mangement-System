@code {
    private List<User> UsersList = new();
    private List<RoleDto> AvailableRoles = new();
    private bool IsLoading = true;
    private string SearchQuery = "";
    private string SelectedRoleFilter = "All";

    private string? SuccessMessage;
    private string? ErrorMessage;

    // Role assignment modal
    private bool ShowRoleModal = false;
    private User? SelectedUserForRoles;
    private HashSet<int> SelectedRoleIdsForUser = new();
    private bool IsSavingRoles = false;

    // User creation modal
    private bool ShowCreateModal = false;
    private bool IsSubmitting = false;
    private string NewUsername = "";
    private string NewDisplayName = "";
    private string NewEmail = "";
    private string NewPassword = "";
    private string NewRole = "User";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var usersTask = AuthService.GetAllUsersFromDbAsync();
            var rolesTask = RbacService.GetRolesAsync();
            await Task.WhenAll(usersTask, rolesTask);

            UsersList = await usersTask;
            AvailableRoles = await rolesTask;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load data: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<string> GetUserRoleNames(User user)
    {
        if (user.UserRoles != null && user.UserRoles.Any())
        {
            return user.UserRoles
                .Where(ur => ur.Role != null)
                .Select(ur => ur.Role.RoleName)
                .Distinct()
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(user.Role))
        {
            return new List<string> { user.Role };
        }

        return new List<string> { "User" };
    }

    private bool IsStaffOrAdmin(User user)
    {
        var roles = GetUserRoleNames(user);
        return roles.Any(r => !r.Equals("User", StringComparison.OrdinalIgnoreCase));
    }

    private string GetRoleBadgeClass(string roleName) => roleName.ToLowerInvariant() switch
    {
        "superadmin" => "badge-superadmin",
        "admin" => "badge-admin",
        "contentmoderator" => "badge-moderator",
        "user" => "badge-user",
        _ => "badge-custom"
    };

    private List<User> FilteredUsers
    {
        get
        {
            var list = UsersList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.Trim().ToLower();
                list = list.Where(u =>
                    (u.UserName != null && u.UserName.ToLower().Contains(q)) ||
                    (u.DisplayName != null && u.DisplayName.ToLower().Contains(q)) ||
                    (u.Email != null && u.Email.ToLower().Contains(q)));
            }

            if (SelectedRoleFilter != "All")
            {
                list = list.Where(u => GetUserRoleNames(u).Contains(SelectedRoleFilter, StringComparer.OrdinalIgnoreCase));
            }

            return list.ToList();
        }
    }

    private void OpenRoleModal(User user)
    {
        SelectedUserForRoles = user;
        SelectedRoleIdsForUser.Clear();

        if (user.UserRoles != null && user.UserRoles.Any())
        {
            foreach (var ur in user.UserRoles)
            {
                SelectedRoleIdsForUser.Add(ur.RoleId);
            }
        }
        else
        {
            // Map fallback string role to roleId
            var matched = AvailableRoles.FirstOrDefault(r => r.RoleName.Equals(user.Role, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                SelectedRoleIdsForUser.Add(matched.RoleId);
            }
        }

        ShowRoleModal = true;
    }

    private void CloseRoleModal()
    {
        ShowRoleModal = false;
        SelectedUserForRoles = null;
        SelectedRoleIdsForUser.Clear();
    }

    private void ToggleRoleSelection(int roleId, bool isChecked)
    {
        if (isChecked)
        {
            SelectedRoleIdsForUser.Add(roleId);
        }
        else
        {
            SelectedRoleIdsForUser.Remove(roleId);
        }
    }

    private async Task SaveUserRolesAsync()
    {
        if (SelectedUserForRoles == null) return;

        ErrorMessage = null;
        SuccessMessage = null;

        // Safety check: protect primary admin
        if (SelectedUserForRoles.UserName.Equals("admin", StringComparison.OrdinalIgnoreCase))
        {
            var adminRoleIds = AvailableRoles
                .Where(r => r.RoleName.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase) || r.RoleName.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                .Select(r => r.RoleId)
                .ToHashSet();

            if (!SelectedRoleIdsForUser.Any(id => adminRoleIds.Contains(id)))
            {
                ErrorMessage = "The primary 'admin' account must retain at least one administrative role (SuperAdmin or Admin).";
                return;
            }
        }

        IsSavingRoles = true;
        try
        {
            var res = await RbacService.AssignUserRolesAsync(SelectedUserForRoles.Id, SelectedRoleIdsForUser.ToList());
            if (res.IsSuccess)
            {
                SuccessMessage = $"Updated role assignments for '{SelectedUserForRoles.DisplayName ?? SelectedUserForRoles.UserName}'.";
                CloseRoleModal();

                // If updated active user, refresh their permissions cache in AuthService
                if (AuthService.CurrentUser.Id == SelectedUserForRoles.Id)
                {
                    await AuthService.RefreshPermissionsAsync();
                }

                await LoadDataAsync();
            }
            else
            {
                ErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to assign roles: " + ex.Message;
        }
        finally
        {
            IsSavingRoles = false;
        }
    }

    private async Task ToggleUserDelete(User user)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        var ok = await AuthService.ToggleUserDeletedInDbAsync(user.Id);
        if (ok)
        {
            user.IsDeleted = !user.IsDeleted;
            SuccessMessage = user.IsDeleted
                ? $"Deactivated user {user.DisplayName ?? user.UserName}."
                : $"Restored user {user.DisplayName ?? user.UserName}.";
        }
        else
        {
            ErrorMessage = "Failed to toggle user status in database.";
        }
    }

    private void OpenCreateModal()
    {
        NewUsername = "";
        NewDisplayName = "";
        NewEmail = "";
        NewPassword = "";
        NewRole = AvailableRoles.FirstOrDefault(r => r.RoleName == "User")?.RoleName ?? "User";
        ShowCreateModal = true;
    }

    private void CloseCreateModal()
    {
        ShowCreateModal = false;
    }

    private async Task HandleCreateUser()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;

        try
        {
            var res = await AuthService.RegisterAsync(NewUsername, NewDisplayName, NewEmail, NewPassword, NewRole);
            if (res != null && res.IsSuccess)
            {
                SuccessMessage = $"User '{NewDisplayName}' created successfully!";
                CloseCreateModal();
                await LoadDataAsync();
            }
            else
            {
                ErrorMessage = res?.Message ?? "Failed to create user.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Create user error: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
