@page "/admin/users"
@layout AdminLayout
@using DotNetProject.Balzor.Components.Layout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Database.AppDbModels
@inject AuthService AuthService
@inject RbacService RbacService
@rendermode InteractiveServer

<PageTitle>Users &amp; Roles — NangWorld Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>User &amp; Role Management</h1>
        <p>Manage member accounts, assign dynamic roles, and configure granular permissions across the platform.</p>
    </div>
    <div class="admin-header-actions">
        @if (AuthService.HasPermission("User.Create"))
        {
            <button type="button" class="btn-admin btn-admin-primary" @onclick="OpenCreateModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add New User
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="user-alert success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>@SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="user-alert error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@ErrorMessage</span>
    </div>
}

<!-- Claymorphic Stats Overview -->
<div class="admin-stat-grid" style="margin-bottom: 24px;">
    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon blush">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <span class="admin-stat-chip blush">Total Members</span>
        </div>
        <div class="admin-stat-value">@UsersList.Count</div>
        <div class="admin-stat-label">Registered in SQL Server DB</div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon honey">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span class="admin-stat-chip honey">Staff &amp; Admins</span>
        </div>
        <div class="admin-stat-value">@UsersList.Count(IsStaffOrAdmin)</div>
        <div class="admin-stat-label">Privileged Access Roles</div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-top">
            <div class="admin-stat-icon sage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
            </div>
            <span class="admin-stat-chip sage">Dynamic Roles</span>
        </div>
        <div class="admin-stat-value">@AvailableRoles.Count</div>
        <div class="admin-stat-label">Configured in System</div>
    </div>
</div>

<!-- Search and Role Filter Bar -->
<div class="admin-card" style="margin-bottom: 24px; padding: 16px 20px;">
    <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
        <div style="display: flex; gap: 12px; align-items: center; flex: 1; min-width: 260px;">
            <div class="search-input-wrap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" placeholder="Search by name, username, or email..." @bind="SearchQuery" @bind:event="oninput" class="search-box-input" />
            </div>
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <button type="button" class="filter-chip @(SelectedRoleFilter == "All" ? "active" : "")" @onclick='() => SelectedRoleFilter = "All"'>All</button>
            @foreach (var role in AvailableRoles)
            {
                var rName = role.RoleName;
                <button type="button" class="filter-chip @(SelectedRoleFilter == rName ? "active" : "")" @onclick="() => SelectedRoleFilter = rName">
                    @rName
                </button>
            }
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h2>Database User Directory</h2>
            <p>Showing @FilteredUsers.Count member accounts with dynamic role assignments</p>
        </div>
        <button type="button" class="btn-admin btn-admin-secondary" style="font-size:.78rem" @onclick="LoadDataAsync">
            Refresh List
        </button>
    </div>

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 40px; color: #7A908A;">
            <p>Loading database users and dynamic role assignments...</p>
        </div>
    }
    else if (!FilteredUsers.Any())
    {
        <div style="text-align: center; padding: 50px 20px; color: #7A908A;">
            <p>No user accounts matched the filter.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Assigned Dynamic Roles</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredUsers)
                    {
                        var isSysAdmin = user.UserName.Equals("admin", StringComparison.OrdinalIgnoreCase);
                        var roles = GetUserRoleNames(user);
                        <tr class="@(user.IsDeleted ? "row-deleted" : "")">
                            <td>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div class="user-tbl-avatar @(isSysAdmin ? "avatar-admin" : "avatar-user")">
                                        @((!string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : user.UserName).Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; color: #2C3531;">@(!string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : user.UserName)</div>
                                        <div style="font-size: 12px; color: #7A908A;">@@@user.UserName</div>
                                    </div>
                                </div>
                            </td>
                            <td style="color: #2C3531; font-size: 13px;">@user.Email</td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    @if (roles.Any())
                                    {
                                        @foreach (var rName in roles)
                                        {
                                            <span class="role-badge @GetRoleBadgeClass(rName)">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                                <span>@rName</span>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="role-badge badge-user">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                            <span>User</span>
                                        </span>
                                    }
                                </div>
                            </td>
                            <td style="color: #7A908A; font-size: 12px;">
                                @user.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (user.IsDeleted)
                                {
                                    <span class="status-badge badge-inactive">Inactive</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-active">Active</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 8px; align-items: center;">
                                    @if (AuthService.HasPermission("User.AssignRole"))
                                    {
                                        <button type="button" class="btn-action-pill btn-action-roles"
                                                @onclick="() => OpenRoleModal(user)"
                                                title="Assign dynamic roles">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                            Manage Roles
                                        </button>
                                    }

                                    @if (!isSysAdmin && AuthService.HasPermission("User.Delete"))
                                    {
                                        <button type="button" class="btn-action-icon @(user.IsDeleted ? "restore" : "delete")"
                                                @onclick="() => ToggleUserDelete(user)"
                                                title="@(user.IsDeleted ? "Restore account" : "Deactivate account")">
                                            @if (user.IsDeleted)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            }
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal: Manage Roles -->
@if (ShowRoleModal && SelectedUserForRoles != null)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="user-tbl-avatar avatar-admin" style="width: 32px; height: 32px; font-size: 13px;">
                        @((!string.IsNullOrWhiteSpace(SelectedUserForRoles.DisplayName) ? SelectedUserForRoles.DisplayName : SelectedUserForRoles.UserName).Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h3 style="margin: 0;">Assign Roles: @SelectedUserForRoles.DisplayName</h3>
                        <span style="font-size: 12px; color: #7A908A;">@@@SelectedUserForRoles.UserName • @SelectedUserForRoles.Email</span>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseRoleModal">&times;</button>
            </div>

            <div class="modal-body">
                <p style="font-size: 13px; color: #7A908A; margin-top: 0; margin-bottom: 12px;">
                    Select one or more dynamic roles to grant permissions to this member. Changes take effect immediately.
                </p>

                <div class="role-selection-grid">
                    @foreach (var role in AvailableRoles.Where(r => r.IsActive))
                    {
                        var isChecked = SelectedRoleIdsForUser.Contains(role.RoleId);
                        <label class="role-select-card @(isChecked ? "selected" : "")">
                            <input type="checkbox"
                                   class="role-select-check"
                                   checked="@isChecked"
                                   @onchange="(e) => ToggleRoleSelection(role.RoleId, (bool)(e.Value ?? false))" />
                            <div class="role-select-content">
                                <div class="role-select-title">
                                    <span class="role-name">@role.RoleName</span>
                                    @if (role.IsSystemRole)
                                    {
                                        <span class="chip-sys">System</span>
                                    }
                                </div>
                                <div class="role-select-desc">
                                    @(string.IsNullOrWhiteSpace(role.Description) ? "No description provided." : role.Description)
                                </div>
                                <div class="role-select-meta">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    <span>@role.PermissionCodes.Count permissions</span>
                                </div>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseRoleModal">Cancel</button>
                <button type="button" class="btn-modal-save" @onclick="SaveUserRolesAsync" disabled="@IsSavingRoles">
                    @(IsSavingRoles ? "Saving..." : "Save Role Assignments")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Add New User -->
@if (ShowCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Add User Account</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseCreateModal">&times;</button>
            </div>

            <form @onsubmit="HandleCreateUser">
                <div class="modal-body">
                    <div class="form-group-admin">
                        <label>Username</label>
                        <input type="text" class="input-admin" placeholder="e.g. kpop_fan" @bind="NewUsername" required />
                    </div>

                    <div class="form-group-admin">
                        <label>Display Name</label>
                        <input type="text" class="input-admin" placeholder="e.g. Min-ho Lee" @bind="NewDisplayName" required />
                    </div>

                    <div class="form-group-admin">
                        <label>Email Address</label>
                        <input type="email" class="input-admin" placeholder="e.g. user@example.com" @bind="NewEmail" required />
                    </div>

                    <div class="form-group-admin">
                        <label>Password</label>
                        <input type="password" class="input-admin" placeholder="Enter secure password" @bind="NewPassword" required />
                    </div>

                    <div class="form-group-admin">
                        <label>Primary Role</label>
                        <select class="input-admin" @bind="NewRole">
                            @foreach (var r in AvailableRoles.Where(r => r.IsActive))
                            {
                                <option value="@r.RoleName">@r.RoleName (@r.PermissionCodes.Count perms)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseCreateModal">Cancel</button>
                    <button type="submit" class="btn-modal-save" disabled="@IsSubmitting">
                        @(IsSubmitting ? "Saving..." : "Create Account")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<style>
    .search-input-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #FDFBF7;
        border: 1px solid rgba(44, 53, 49, 0.1);
        border-radius: 12px;
        padding: 8px 16px;
        flex: 1;
        color: #2C3531;
    }

    .search-box-input {
        background: transparent;
        border: none;
        color: #2C3531;
        font-size: 14px;
        outline: none;
        width: 100%;
    }

    .filter-chip {
        background: #EAE3D2;
        border: 1px solid rgba(44, 53, 49, 0.08);
        color: #2C3531;
        padding: 6px 14px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .filter-chip.active {
        background: #DE7149;
        color: #fff;
        border-color: #DE7149;
        box-shadow: 2px 2px 6px rgba(222, 113, 73, 0.3);
    }

    .user-tbl-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 14px;
    }

    .avatar-admin {
        background: rgba(222, 113, 73, 0.15);
        color: #DE7149;
        border: 1px solid rgba(222, 113, 73, 0.3);
    }

    .avatar-user {
        background: rgba(103, 142, 131, 0.15);
        color: #385E55;
        border: 1px solid rgba(103, 142, 131, 0.3);
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 14px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .badge-superadmin {
        background: rgba(212, 163, 115, 0.25);
        color: #8C5E28;
        border: 1px solid rgba(212, 163, 115, 0.5);
    }

    .badge-admin {
        background: rgba(222, 113, 73, 0.15);
        color: #C05830;
        border: 1px solid rgba(222, 113, 73, 0.35);
    }

    .badge-moderator {
        background: rgba(103, 142, 131, 0.2);
        color: #2F5950;
        border: 1px solid rgba(103, 142, 131, 0.4);
    }

    .badge-user {
        background: rgba(44, 53, 49, 0.08);
        color: #556B64;
        border: 1px solid rgba(44, 53, 49, 0.15);
    }

    .badge-custom {
        background: rgba(150, 120, 200, 0.15);
        color: #6A4595;
        border: 1px solid rgba(150, 120, 200, 0.35);
    }

    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-active {
        background: rgba(46, 125, 50, 0.12);
        color: #2E7D32;
    }

    .badge-inactive {
        background: rgba(198, 40, 40, 0.12);
        color: #C62828;
    }

    .row-deleted {
        opacity: 0.5;
    }

    .btn-action-pill {
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
    }

    .btn-action-roles {
        background: #EAE3D2;
        color: #2C3531;
        border: 1px solid rgba(44, 53, 49, 0.12);
    }

    .btn-action-roles:hover {
        background: #DE7149;
        color: #fff;
        border-color: #DE7149;
    }

    .btn-action-icon {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        color: #7A908A;
        transition: all 0.15s ease;
    }

    .btn-action-icon.delete:hover {
        color: #C62828;
        background: rgba(198, 40, 40, 0.1);
    }

    .btn-action-icon.restore:hover {
        color: #2E7D32;
        background: rgba(46, 125, 50, 0.1);
    }

    .user-alert {
        padding: 12px 18px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-alert.success {
        background: rgba(46, 125, 50, 0.12);
        border: 1px solid rgba(46, 125, 50, 0.3);
        color: #2E7D32;
    }

    .user-alert.error {
        background: rgba(198, 40, 40, 0.12);
        border: 1px solid rgba(198, 40, 40, 0.3);
        color: #C62828;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(44, 53, 49, 0.45);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }

    .modal-card {
        background: #FDFBF7;
        border: 1px solid rgba(44, 53, 49, 0.15);
        border-radius: 20px;
        width: 100%;
        max-width: 560px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
        color: #2C3531;
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(44, 53, 49, 0.08);
    }

    .modal-header h3 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
    }

    .modal-close-btn {
        background: transparent;
        border: none;
        color: #7A908A;
        font-size: 24px;
        cursor: pointer;
        line-height: 1;
    }

    .modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-height: 65vh;
        overflow-y: auto;
    }

    .role-selection-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .role-select-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        background: #F4EFEA;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .role-select-card:hover {
        background: #ECE5DC;
    }

    .role-select-card.selected {
        background: #FAF2EC;
        border-color: #DE7149;
    }

    .role-select-check {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        cursor: pointer;
        accent-color: #DE7149;
    }

    .role-select-content {
        flex: 1;
    }

    .role-select-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .role-name {
        font-weight: 700;
        font-size: 14px;
        color: #2C3531;
    }

    .chip-sys {
        font-size: 10px;
        font-weight: 700;
        background: rgba(222, 113, 73, 0.15);
        color: #DE7149;
        padding: 2px 6px;
        border-radius: 8px;
    }

    .role-select-desc {
        font-size: 12px;
        color: #556B64;
        line-height: 1.4;
        margin-bottom: 4px;
    }

    .role-select-meta {
        font-size: 11px;
        color: #7A908A;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .form-group-admin {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group-admin label {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #556B64;
    }

    .input-admin {
        background: #F4EFEA;
        border: 1px solid rgba(44, 53, 49, 0.15);
        border-radius: 10px;
        padding: 10px 14px;
        color: #2C3531;
        font-size: 14px;
        outline: none;
    }

    .input-admin:focus {
        border-color: #DE7149;
    }

    .modal-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding: 18px 24px;
        border-top: 1px solid rgba(44, 53, 49, 0.08);
    }

    .btn-modal-cancel {
