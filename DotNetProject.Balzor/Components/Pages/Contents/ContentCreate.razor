@page "/contents/create"
@using DotNetProject.Balzor.Components.Shared
@inject HttpClientService ApiClient
@inject NavigationManager Nav

<PageTitle>Add Content — MyFlix</PageTitle>

<div class="form-page">
    <div class="form-header">
        <a href="/contents" class="btn btn-outline btn-sm">? Back to Contents</a>
        <h2>Add New Content</h2>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="form-card">
        <div class="form-row">
            <label>Title <span class="required">*</span></label>
            <input class="form-control" @bind="_form.Title" placeholder="Enter content title" />
        </div>
        <div class="form-row">
            <label>Content Type ID <span class="required">*</span></label>
            <input class="form-control" type="number" @bind="_form.ContentTypeId" />
            <small class="text-muted">1 = Movie, 2 = Drama, etc.</small>
        </div>
        <div class="form-row">
            <label>Description</label>
            <textarea class="form-control" rows="3" @bind="_form.Description" placeholder="Content description..."></textarea>
        </div>
        <div class="form-row-half">
            <div>
                <label>Poster URL</label>
                <input class="form-control" @bind="_form.PosterUrl" placeholder="https://..." />
            </div>
            <div>
                <label>Banner URL</label>
                <input class="form-control" @bind="_form.BannerUrl" placeholder="https://..." />
            </div>
        </div>
        <div class="form-row-half">
            <div>
                <label>Country</label>
                <input class="form-control" @bind="_form.Country" placeholder="e.g. South Korea" />
            </div>
            <div>
                <label>Language</label>
                <input class="form-control" @bind="_form.Language" placeholder="e.g. Korean" />
            </div>
        </div>
        <div class="form-row-half">
            <div>
                <label>Release Date</label>
                <input class="form-control" type="date" value="@_releaseDateStr" @onchange="e => _releaseDateStr = e.Value?.ToString()" />
            </div>
            <div>
                <label>Status</label>
                <select class="form-control" @bind="_form.Status">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Upcoming">Upcoming</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" disabled="@IsSubmitting" @onclick="HandleSubmitAsync">
                @(IsSubmitting ? "Saving..." : "Save Content")
            </button>
            <a href="/contents" class="btn btn-outline">Cancel</a>
        </div>
    </div>
</div>

