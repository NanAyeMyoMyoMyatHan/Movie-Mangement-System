@page "/drama/{Id:long}"
@rendermode InteractiveServer

<PageTitle>@(Drama?.Title ?? "Drama Details") - NangWorld</PageTitle>

<style>
    /* Top bar above the theater card */
    .drama-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .drama-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 9999px;
        background: #FFFFFF;
        border: 1px solid rgba(24, 59, 54, 0.12);
        color: #183B36;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease;
    }

    .drama-back-pill:hover {
        background: #DE7149;
        color: #FFFFFF;
        border-color: #DE7149;
        transform: translateX(-3px);
    }

    .drama-top-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .drama-top-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #FFFFFF;
        border: 1px solid rgba(24, 59, 54, 0.12);
        color: #183B36;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .drama-top-icon-btn:hover {
        background: #DE7149;
        color: #FFFFFF;
        border-color: #DE7149;
        transform: scale(1.08);
    }

    /* Main Theater Card (Dashboard Forest Jade Theme) */
    .drama-theater-card {
        background: #0F2420;
        border-radius: 24px;
        padding: 36px 40px 48px;
        color: #F4EFEA;
        box-shadow: 0 16px 40px rgba(15, 36, 32, 0.16);
        border: 1px solid rgba(244, 239, 234, 0.08);
        box-sizing: border-box;
    }

    /* Video Player inside Theater Card */
    .drama-theater-player {
        margin-bottom: 32px;
        background: #000000;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(244, 239, 234, 0.12);
    }

    .drama-player-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: #142E28;
        border-bottom: 1px solid rgba(244, 239, 234, 0.08);
    }

    .drama-player-title {
        font-size: 14.5px;
        font-weight: 700;
        color: #F4EFEA;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .drama-ep-badge {
        background: #DE7149;
        color: #FFFFFF;
        font-size: 11px;
        padding: 2px 10px;
        border-radius: 9999px;
        font-weight: 700;
    }

    .drama-player-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(244, 239, 234, 0.1);
        border: 1px solid rgba(244, 239, 234, 0.15);
        color: #F4EFEA;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-player-close:hover {
        background: #DE7149;
        border-color: #DE7149;
        color: #FFFFFF;
    }

    .drama-video {
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 540px;
        display: block;
        background: #000000;
    }

    /* Hero Section - 2 Columns (Image 2 Design) */
    .drama-hero {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 36px;
        margin-bottom: 40px;
    }

    .drama-poster-wrap {
        width: 240px;
        min-width: 240px;
        aspect-ratio: 3 / 4;
        border-radius: 16px;
        overflow: hidden;
        background: #16362F;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(244, 239, 234, 0.12);
        flex-shrink: 0;
    }

    .drama-poster {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .drama-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .drama-heading {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 34px;
        font-weight: 800;
        color: #F4EFEA;
        margin: 0;
        line-height: 1.18;
    }

    .drama-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 13.5px;
        color: #9DB4AE;
    }

    .badge-gold-hd {
        background: #F59E0B;
        color: #000000;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 4px;
        line-height: 1.2;
    }

    .badge-dark-pill {
        background: rgba(244, 239, 234, 0.12);
        color: #F4EFEA;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        line-height: 1.2;
    }

    .drama-desc {
        font-size: 14px;
        line-height: 1.65;
        color: #B5C4BF;
        margin: 4px 0 8px;
        max-width: 740px;
    }

    .drama-btns {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 6px 0 14px;
    }

    .drama-btn-play {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #DE7149 !important;
        color: #FFFFFF !important;
        border: 0 !important;
        border-radius: 9999px;
        padding: 11px 28px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(222, 113, 73, 0.35);
        transition: all 0.2s ease;
    }

    .drama-btn-play:hover {
        background: #C85C34 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(222, 113, 73, 0.45);
    }

    .drama-btn-watchlist {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(244, 239, 234, 0.08) !important;
        border: 1.5px solid rgba(244, 239, 234, 0.25) !important;
        color: #F4EFEA !important;
        border-radius: 9999px;
        padding: 10px 22px;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-btn-watchlist:hover {
        background: rgba(244, 239, 234, 0.16) !important;
        border-color: rgba(244, 239, 234, 0.4) !important;
        transform: translateY(-1px);
    }

    .drama-credits-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        margin-top: 4px;
    }

    .drama-credit-item {
        display: flex;
        gap: 16px;
    }

    .drama-credit-lbl {
        width: 70px;
        color: #6E8882;
        font-weight: 500;
        flex-shrink: 0;
    }

    .drama-credit-val {
        color: #C5D2CE;
    }

    /* Episodes Section Header */
    .drama-ep-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(244, 239, 234, 0.1);
        margin-bottom: 14px;
    }

    .drama-ep-title-h2 {
        font-size: 21px;
        font-weight: 800;
        color: #F4EFEA;
        margin: 0;
    }

    .drama-ep-count-span {
        font-size: 13.5px;
        color: #8FA9AA;
        font-weight: 600;
    }

    /* Episodes List Rows (Horizontal rows like Photo 2) */
    .drama-episodes-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .drama-episode-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-episode-item:hover {
        background: rgba(222, 113, 73, 0.08);
        border-color: rgba(222, 113, 73, 0.35);
        transform: translateX(4px);
    }

    .drama-episode-item.active {
        background: rgba(222, 113, 73, 0.16);
        border-left: 4px solid #DE7149;
    }

    .drama-ep-thumb-wrapper {
        position: relative;
        width: 145px;
        height: 82px;
        flex-shrink: 0;
        border-radius: 10px;
        overflow: hidden;
        background: #142C27;
    }

    .drama-ep-thumb-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .drama-ep-disc-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.35);
        transition: background 0.15s ease;
    }

    .drama-episode-item:hover .drama-ep-disc-overlay {
        background: rgba(0, 0, 0, 0.1);
    }

    .drama-ep-disc-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(15, 36, 32, 0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #F4EFEA;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .drama-episode-item:hover .drama-ep-disc-circle {
        transform: scale(1.15);
        background: #DE7149;
        color: #FFFFFF;
    }

    .drama-ep-info-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .drama-ep-name-h4 {
        font-size: 15px;
        font-weight: 700;
        color: #F4EFEA;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .drama-ep-desc-p {
        font-size: 12.5px;
        color: #8FA9AA;
        line-height: 1.45;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .drama-ep-actions-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .drama-ep-time {
        font-size: 13px;
        color: #8FA9AA;
        font-weight: 500;
    }

    .drama-ep-circle-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1.5px solid rgba(244, 239, 234, 0.35) !important;
        background: transparent !important;
        color: #F4EFEA !important;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        padding: 0;
    }

    .drama-episode-item:hover .drama-ep-circle-btn {
        border-color: #DE7149 !important;
        background: #DE7149 !important;
        color: #FFFFFF !important;
        transform: scale(1.1);
    }

    .drama-ep-options-btn {
        color: #6E8882 !important;
        background: transparent !important;
        border: 0 !important;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .drama-ep-options-btn:hover {
        color: #F4EFEA !important;
    }

    .drama-now-playing-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: rgba(222, 113, 73, 0.15);
        border: 1px solid rgba(222, 113, 73, 0.4);
        border-radius: 12px;
        margin-bottom: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-now-playing-banner:hover {
        background: rgba(222, 113, 73, 0.25);
        transform: translateY(-2px);
    }

    .now-playing-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .now-playing-pulse {
        width: 10px;
        height: 10px;
        background: #DE7149;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(222, 113, 73, 0.7);
        animation: pulseOrange 1.5s infinite;
    }

    @@keyframes pulseOrange {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(222, 113, 73, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(222, 113, 73, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(222, 113, 73, 0); }
    }

    .now-playing-text {
        font-size: 13.5px;
        color: #F4EFEA;
    }

    .now-playing-scroll-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #DE7149;
        color: #FFFFFF;
        border: 0;
        border-radius: 9999px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .ep-playing-pill {
        background: #DE7149;
        color: #FFFFFF;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        box-shadow: 0 2px 8px rgba(222, 113, 73, 0.4);
    }

    .drama-loading-box {
        padding: 60px 20px;
        text-align: center;
        color: #183B36;
    }

    .drama-spinner-circle {
        width: 44px;
        height: 44px;
        border: 3.5px solid rgba(24, 59, 54, 0.15);
        border-top-color: #DE7149;
        border-radius: 50%;
        animation: dramaSpin 0.8s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes dramaSpin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 992px) {
        .drama-theater-card {
            padding: 24px 20px;
        }
        .drama-hero {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .drama-poster-wrap {
            width: 190px;
            min-width: 190px;
        }
        .drama-meta, .drama-btns, .drama-credit-item {
            justify-content: center;
        }
        .drama-ep-desc-p {
            display: none;
        }
    }
</style>

<div class="drama-page-flow">
    <!-- Top Action Bar (Back to Browse + Cast) -->
    <div class="drama-top-bar">
        <button class="drama-back-pill" @onclick="GoBack" title="Back to Catalog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>Back to Browse</span>
        </button>

        <div class="drama-top-actions">
            <button class="drama-top-icon-btn" title="Cast to TV">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="2" y1="20" x2="2.01" y2="20"></line>
                    <path d="M5 20a5 5 0 0 0-5-5"></path>
                    <path d="M9 20a9 9 0 0 0-9-9"></path>
                    <path d="M2 12V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"></path>
                </svg>
            </button>
            <button class="drama-top-icon-btn" @onclick="GoBack" title="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="drama-loading-box">
            <div class="drama-spinner-circle"></div>
            <p>Loading drama details and episodes...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="drama-loading-box">
            <h3 style="color:#183B36;">Unable to load drama</h3>
            <p style="color:#5C6B64;">@ErrorMessage</p>
            <button class="drama-btn-play" style="margin-top:16px;" @onclick="GoBack">Back to Home</button>
        </div>
    }
    else if (Drama != null)
    {
        <!-- Deep Forest Theater Card (Matching Dashboard Theme) -->
        <div class="drama-theater-card">
            <!-- Video Player (Appears when episode or play is clicked!) -->
            @if (IsPlayingVideo)
            {
                <div id="videoPlayerBox" class="drama-theater-player">
                    <div class="drama-player-bar">
                        <div class="drama-player-title">
                            <span>@ActiveVideoTitle</span>
                            <span class="drama-ep-badge">EP @ActiveEpisodeNumber</span>
                        </div>
                        <button type="button" class="drama-player-close" @onclick="StopPlaying" title="Close Video Player">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <video class="drama-video" src="@ActiveVideoUrl" controls autoplay poster="@ActiveVideoPoster" preload="auto">
                        Your browser does not support the video tag.
                    </video>
                </div>
            }

            <!-- Hero Section: Cover on Left, Details on Right (Photo 2 Layout) -->
            <div class="drama-hero">
                <div class="drama-poster-wrap">
                    <img src="@Drama.PosterUrl" alt="@Drama.Title" class="drama-poster" />
                </div>

                <div class="drama-info">
                    <h1 class="drama-heading">@Drama.Title</h1>

                    <div class="drama-meta">
                        <span>@DramaYear</span>
                        <span>•</span>
                        <span>@DramaTotalEpisodesText</span>
                        <span>•</span>
                        <span>@DramaGenres</span>
                        <span class="badge-gold-hd">HD</span>
                        <span class="badge-dark-pill">@DramaAgeRating</span>
                        <span class="badge-dark-pill">@DramaLanguage</span>
                    </div>

                    <p class="drama-desc">@Drama.Description</p>

                    <div class="drama-btns">
                        <button class="drama-btn-play" @onclick="StartPlayingFirstEpisode">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>Play</span>
                        </button>

                        <button class="drama-btn-watchlist" @onclick="ToggleWatchlist">
                            @if (IsWatchlisted)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span style="color:#10b981;">In Watchlist</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add to Watchlist</span>
                            }
                        </button>

                        <button class="drama-btn-watchlist">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                <polyline points="16 6 12 2 8 6"></polyline>
                                <line x1="12" y1="2" x2="12" y2="15"></line>
                            </svg>
                            <span>Share</span>
                        </button>
                    </div>

                    <div class="drama-credits-list">
                        <div class="drama-credit-item">
                            <span class="drama-credit-lbl">Starring</span>
                            <span class="drama-credit-val">@DramaStarring</span>
                        </div>
                        <div class="drama-credit-item">
                            <span class="drama-credit-lbl">Creators</span>
                            <span class="drama-credit-val">@DramaCreators</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Episodes Section Header -->
            <div class="drama-ep-header">
                <h2 class="drama-ep-title-h2">Episodes</h2>
                <span class="drama-ep-count-span">@DramaTotalEpisodesText</span>
            </div>

            <!-- Now Playing Interactive Banner -->
            @if (IsPlayingVideo)
            {
                <div class="drama-now-playing-banner" @onclick="ScrollToPlayer" title="Click to view Video Player at top">
                    <div class="now-playing-left">
                        <span class="now-playing-pulse"></span>
                        <span class="now-playing-text">Now Playing: <strong>EP @ActiveEpisodeNumber - @ActiveVideoTitle</strong></span>
                    </div>
                    <button type="button" class="now-playing-scroll-btn">
                        <span>Watch Player</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="18 15 12 9 6 15"></polyline>
                        </svg>
                    </button>
                </div>
            }

            <!-- Episodes List (Horizontal Rows like Image 2) -->
            <div class="drama-episodes-container">
                @if (Episodes != null && Episodes.Any())
                {
                    @foreach (var ep in Episodes)
                    {
                        var currentEp = ep;
                        bool isCurrentPlaying = (currentEp.EpisodeNumber == ActiveEpisodeNumber && IsPlayingVideo);
                        <div class="drama-episode-item @(isCurrentPlaying ? "active" : "")" @onclick="() => PlayEpisode(currentEp)">
                            <div class="drama-ep-thumb-wrapper">
                                <img src="@GetEpisodeThumbnail(currentEp)" alt="Episode @currentEp.EpisodeNumber" class="drama-ep-thumb-image" />
                                <div class="drama-ep-disc-overlay">
                                    <div class="drama-ep-disc-circle">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="drama-ep-info-col">
                                <h4 class="drama-ep-name-h4">@currentEp.EpisodeNumber. @(string.IsNullOrWhiteSpace(currentEp.Title) ? $"Episode {currentEp.EpisodeNumber}" : currentEp.Title)</h4>
                                <p class="drama-ep-desc-p">@(string.IsNullOrWhiteSpace(currentEp.Description) ? Drama.Description : currentEp.Description)</p>
                            </div>
                            <div class="drama-ep-actions-right">
                                @if (isCurrentPlaying)
                                {
                                    <span class="ep-playing-pill">▶ Playing</span>
                                }
                                <span class="drama-ep-time">@(currentEp.Duration.HasValue && currentEp.Duration.Value > 0 ? $"{currentEp.Duration.Value} min" : "70 min")</span>
                                <button type="button" class="drama-ep-circle-btn" @onclick="() => PlayEpisode(currentEp)" title="Play Episode @currentEp.EpisodeNumber">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                    </svg>
                                </button>
                                <button type="button" class="drama-ep-options-btn" title="More options" @onclick:stopPropagation="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="1"></circle>
                                        <circle cx="12" cy="5" r="1"></circle>
                                        <circle cx="12" cy="19" r="1"></circle>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 30px; text-align: center; color: #8FA9AA;">
                        <p>No episodes found for this series.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>
