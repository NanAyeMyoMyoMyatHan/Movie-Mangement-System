@page "/drama/{Id:long}"
@rendermode InteractiveServer

<PageTitle>@(Drama?.Title ?? "Drama Details") - NangWorld</PageTitle>

<style>
    /* Fullscreen dark overlay container - completely overrides any parent layout backgrounds */
    .sd-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 99999;
        background: #080C0B !important;
        color: #FFFFFF !important;
        overflow-y: auto;
        font-family: 'Plus Jakarta Sans', 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        box-sizing: border-box;
    }

    .sd-wrapper {
        max-width: 1050px;
        margin: 0 auto;
        padding: 24px 32px 80px;
        box-sizing: border-box;
    }

    /* Top Navigation */
    .sd-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .sd-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #FFFFFF !important;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }

    .sd-icon-btn:hover {
        background: rgba(255, 255, 255, 0.22) !important;
        transform: scale(1.08);
    }

    .sd-nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Video Player Area */
    .sd-player-wrap {
        margin-bottom: 32px;
        background: #000000;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .sd-player-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: #0F1D19;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sd-player-info {
        font-size: 14px;
        font-weight: 700;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sd-badge-now-playing {
        background: #3B82F6;
        color: #FFFFFF;
        font-size: 11px;
        padding: 2px 10px;
        border-radius: 9999px;
        font-weight: 700;
    }

    .sd-video-element {
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 540px;
        display: block;
        background: #000000;
    }

    /* Hero Section - 2 Columns (Image 2 Design) */
    .sd-hero {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 36px;
        margin-bottom: 40px;
    }

    .sd-poster-box {
        width: 240px;
        min-width: 240px;
        aspect-ratio: 3 / 4;
        border-radius: 14px;
        overflow: hidden;
        background: #142421;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.12);
        flex-shrink: 0;
    }

    .sd-poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .sd-info-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sd-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 34px;
        font-weight: 800;
        color: #FFFFFF;
        margin: 0;
        line-height: 1.18;
    }

    .sd-meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 13.5px;
        color: #A3B3AE;
    }

    .sd-dot {
        opacity: 0.5;
    }

    .sd-badge-hd {
        background: #F59E0B;
        color: #000000;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 4px;
        line-height: 1.2;
    }

    .sd-badge-pill {
        background: rgba(255, 255, 255, 0.12);
        color: #E2E8F0;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        line-height: 1.2;
    }

    .sd-synopsis {
        font-size: 14px;
        line-height: 1.6;
        color: #9AA7A2;
        margin: 4px 0 6px;
        max-width: 740px;
    }

    /* Action Buttons Row */
    .sd-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 6px 0 12px;
    }

    .sd-btn-play {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #4F46E5 !important;
        color: #FFFFFF !important;
        border: 0 !important;
        border-radius: 10px;
        padding: 10px 26px;
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(79, 70, 229, 0.4);
        transition: all 0.2s ease;
    }

    .sd-btn-play:hover {
        background: #4338CA !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(79, 70, 229, 0.55);
    }

    .sd-btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
        color: #F4EFEA !important;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .sd-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.16) !important;
        border-color: rgba(255, 255, 255, 0.3) !important;
    }

    /* Credits */
    .sd-credits {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        margin-top: 4px;
    }

    .sd-credits-row {
        display: flex;
        gap: 16px;
    }

    .sd-credits-label {
        width: 65px;
        color: #6E7D76;
        font-weight: 500;
        flex-shrink: 0;
    }

    .sd-credits-value {
        color: #B5BFBA;
    }

    /* Episodes Section Header */
    .sd-episodes-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 10px;
    }

    .sd-episodes-title {
        font-size: 21px;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
    }

    .sd-episodes-count {
        font-size: 13px;
        color: #8C9993;
        font-weight: 500;
    }

    /* Episode Rows List (Horizontal rows like Photo 2) */
    .sd-ep-list {
        display: flex;
        flex-direction: column;
    }

    .sd-ep-row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 15px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.18s ease;
    }

    .sd-ep-row:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .sd-ep-row.active {
        background: rgba(79, 70, 229, 0.18);
        border-left: 3px solid #4F46E5;
    }

    .sd-ep-thumb {
        position: relative;
        width: 145px;
        height: 82px;
        flex-shrink: 0;
        border-radius: 8px;
        overflow: hidden;
        background: #182824;
    }

    .sd-ep-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .sd-ep-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.38);
        transition: background 0.15s ease;
    }

    .sd-ep-row:hover .sd-ep-overlay {
        background: rgba(0, 0, 0, 0.15);
    }

    .sd-ep-disc {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .sd-ep-row:hover .sd-ep-disc {
        transform: scale(1.12);
        background: #4F46E5;
    }

    .sd-ep-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sd-ep-name {
        font-size: 15px;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sd-ep-desc {
        font-size: 12.5px;
        color: #8C9993;
        line-height: 1.45;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .sd-ep-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .sd-ep-duration {
        font-size: 13px;
        color: #8C9993;
        font-weight: 500;
    }

    .sd-ep-circle-play {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.35) !important;
        background: transparent !important;
        color: #FFFFFF !important;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        padding: 0;
    }

    .sd-ep-row:hover .sd-ep-circle-play {
        border-color: #FFFFFF !important;
        background: rgba(255, 255, 255, 0.18) !important;
        transform: scale(1.08);
    }

    .sd-ep-dots {
        color: #6E7D76 !important;
        background: transparent !important;
        border: 0 !important;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sd-ep-dots:hover {
        color: #FFFFFF !important;
    }

    /* Loading state */
    .sd-loading {
        padding: 80px 20px;
        text-align: center;
        color: #8C9993;
    }

    .sd-spinner {
        width: 44px;
        height: 44px;
        border: 3.5px solid rgba(255, 255, 255, 0.12);
        border-top-color: #4F46E5;
        border-radius: 50%;
        animation: sdSpin 0.8s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes sdSpin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .sd-wrapper {
            padding: 16px 14px 60px;
        }
        .sd-hero {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .sd-poster-box {
            width: 180px;
            min-width: 180px;
        }
        .sd-meta-row, .sd-actions, .sd-credits-row {
            justify-content: center;
        }
        .sd-ep-desc {
            display: none;
        }
    }
</style>

<div class="sd-container">
    <div class="sd-wrapper">
        <!-- Top Navigation Bar -->
        <div class="sd-nav">
            <button class="sd-icon-btn" @onclick="GoBack" title="Back to Catalog">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <div class="sd-nav-right">
                <button class="sd-icon-btn" title="Cast to TV">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="2" y1="20" x2="2.01" y2="20"></line>
                        <path d="M5 20a5 5 0 0 0-5-5"></path>
                        <path d="M9 20a9 9 0 0 0-9-9"></path>
                        <path d="M2 12V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"></path>
                    </svg>
                </button>
                <button class="sd-icon-btn" @onclick="GoBack" title="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="sd-loading">
                <div class="sd-spinner"></div>
                <p>Loading drama details and episodes...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="sd-loading">
                <h3 style="color:#FFF;">Unable to load drama</h3>
                <p>@ErrorMessage</p>
                <button class="sd-btn-play" style="margin-top:16px;" @onclick="GoBack">Back to Home</button>
            </div>
        }
        else if (Drama != null)
        {
            <!-- Video Player (Appears when episode or play is clicked!) -->
            @if (IsPlayingVideo)
            {
                <div class="sd-player-wrap">
                    <div class="sd-player-header">
                        <div class="sd-player-info">
                            <span>@ActiveVideoTitle</span>
                            <span class="sd-badge-now-playing">EP @ActiveEpisodeNumber</span>
                        </div>
                        <button class="sd-icon-btn" @onclick="StopPlaying" title="Close Video Player">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <video class="sd-video-element" src="@ActiveVideoUrl" controls autoplay poster="@ActiveVideoPoster" preload="auto">
                        Your browser does not support the video tag.
                    </video>
                </div>
            }

            <!-- Hero Section: Cover on Left, Details on Right (Photo 2 Layout) -->
            <div class="sd-hero">
                <div class="sd-poster-box">
                    <img src="@Drama.PosterUrl" alt="@Drama.Title" class="sd-poster-img" />
                </div>

                <div class="sd-info-col">
                    <h1 class="sd-title">@Drama.Title</h1>

                    <div class="sd-meta-row">
                        <span>@DramaYear</span>
                        <span class="sd-dot">•</span>
                        <span>@DramaTotalEpisodesText</span>
                        <span class="sd-dot">•</span>
                        <span>@DramaGenres</span>
                        <span class="sd-badge-hd">HD</span>
                        <span class="sd-badge-pill">@DramaAgeRating</span>
                        <span class="sd-badge-pill">@DramaLanguage</span>
                    </div>

                    <p class="sd-synopsis">@Drama.Description</p>

                    <div class="sd-actions">
                        <button class="sd-btn-play" @onclick="StartPlayingFirstEpisode">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>Play</span>
                        </button>

                        <button class="sd-btn-secondary" @onclick="ToggleWatchlist">
                            @if (IsWatchlisted)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span style="color:#10b981;">In Watchlist</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add to Watchlist</span>
                            }
                        </button>

                        <button class="sd-btn-secondary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                <polyline points="16 6 12 2 8 6"></polyline>
                                <line x1="12" y1="2" x2="12" y2="15"></line>
                            </svg>
                            <span>Share</span>
                        </button>
                    </div>

                    <div class="sd-credits">
                        <div class="sd-credits-row">
                            <span class="sd-credits-label">Starring</span>
                            <span class="sd-credits-value">@DramaStarring</span>
                        </div>
                        <div class="sd-credits-row">
                            <span class="sd-credits-label">Creators</span>
                            <span class="sd-credits-value">@DramaCreators</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Episodes Section Header -->
            <div class="sd-episodes-head">
                <h2 class="sd-episodes-title">Episodes</h2>
                <span class="sd-episodes-count">@DramaTotalEpisodesText</span>
            </div>

            <!-- Episodes List (Horizontal Rows like Image 2) -->
            <div class="sd-ep-list">
                @if (Episodes != null && Episodes.Any())
                {
                    @foreach (var ep in Episodes)
                    {
                        var currentEp = ep;
                        bool isCurrentPlaying = (currentEp.EpisodeNumber == ActiveEpisodeNumber && IsPlayingVideo);
                        <div class="sd-ep-row @(isCurrentPlaying ? "active" : "")" @onclick="() => PlayEpisode(currentEp)">
                            <div class="sd-ep-thumb">
                                <img src="@GetEpisodeThumbnail(currentEp)" alt="Episode @currentEp.EpisodeNumber" class="sd-ep-thumb-img" />
                                <div class="sd-ep-overlay">
                                    <div class="sd-ep-disc">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="sd-ep-info">
                                <h4 class="sd-ep-name">@currentEp.EpisodeNumber. @(string.IsNullOrWhiteSpace(currentEp.Title) ? $"Episode {currentEp.EpisodeNumber}" : currentEp.Title)</h4>
                                <p class="sd-ep-desc">@(string.IsNullOrWhiteSpace(currentEp.Description) ? Drama.Description : currentEp.Description)</p>
                            </div>
                            <div class="sd-ep-right">
                                <span class="sd-ep-duration">@(currentEp.Duration.HasValue && currentEp.Duration.Value > 0 ? $"{currentEp.Duration.Value} min" : "70 min")</span>
                                <button class="sd-ep-circle-play" title="Play Episode @currentEp.EpisodeNumber">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                    </svg>
                                </button>
                                <button class="sd-ep-dots" title="More options" @onclick:stopPropagation="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="1"></circle>
                                        <circle cx="12" cy="5" r="1"></circle>
                                        <circle cx="12" cy="19" r="1"></circle>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 30px; text-align: center; color: #8C9993;">
                        <p>No episodes found for this series.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>
