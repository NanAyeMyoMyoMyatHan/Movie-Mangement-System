@page "/drama/{Id:long}"
@rendermode InteractiveServer

<PageTitle>@(Drama?.Title ?? "Drama Details") - NangWorld</PageTitle>

<style>
    /* Dark Theater Modal/Card Layout matching Reference Photo */
    .drama-theater-container {
        background: #0B1310;
        border-radius: 20px;
        padding: 24px 32px 48px;
        color: #F4EFEA;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-sizing: border-box;
        margin-bottom: 40px;
    }

    /* Top Action Bar (Inside the dark theater card) */
    .drama-theater-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .drama-top-circle-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #FFFFFF;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }

    .drama-top-circle-btn:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #FFFFFF;
        transform: scale(1.08);
    }

    .drama-top-right-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Video Player inside Theater Card */
    .drama-theater-player {
        margin-bottom: 30px;
        background: #000000;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .drama-player-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: #14221D;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .drama-player-title {
        font-size: 14.5px;
        font-weight: 700;
        color: #F4EFEA;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .drama-ep-badge {
        background: #5E5CE6;
        color: #FFFFFF;
        font-size: 11.5px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }

    .drama-player-close {
        background: transparent;
        border: none;
        color: #8FA9AA;
        cursor: pointer;
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .drama-player-close:hover {
        color: #FFFFFF;
        background: rgba(255, 255, 255, 0.1);
    }

    .drama-video {
        width: 100%;
        max-height: 520px;
        display: block;
        background: #000000;
    }

    /* Hero Section: Cover on Left, Info on Right */
    .drama-hero-row {
        display: flex;
        gap: 36px;
        align-items: flex-start;
        margin-bottom: 40px;
    }

    .drama-poster-wrap {
        width: 260px;
        min-width: 260px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
        background: #14221D;
    }

    .drama-poster-img {
        width: 100%;
        height: auto;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
    }

    .drama-info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .drama-heading-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 38px;
        font-weight: 700;
        color: #FFFFFF;
        line-height: 1.15;
        margin: 0 0 12px 0;
        letter-spacing: -0.5px;
    }

    .drama-metadata-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        color: #A0B2AC;
        margin-bottom: 16px;
    }

    .badge-gold-hd {
        background: #E5A93C;
        color: #0B1310;
        font-weight: 800;
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        line-height: 1;
    }

    .badge-meta-pill {
        background: rgba(255, 255, 255, 0.12);
        color: #FFFFFF;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        line-height: 1;
    }

    .drama-synopsis {
        color: #A0B2AC;
        font-size: 14.5px;
        line-height: 1.6;
        margin: 0 0 24px 0;
        max-width: 760px;
    }

    /* Action Buttons Row */
    .drama-hero-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .drama-btn-play-hero {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #5E5CE6;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        padding: 11px 28px;
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(94, 92, 230, 0.4);
        transition: all 0.2s ease;
    }

    .drama-btn-play-hero:hover {
        background: #4F4CD8;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(94, 92, 230, 0.5);
    }

    .drama-btn-action-hero {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #FFFFFF;
        border-radius: 8px;
        padding: 11px 22px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-btn-action-hero:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.35);
        color: #FFFFFF;
    }

    /* Starring & Creators */
    .drama-credits-box {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 13.5px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 20px;
        max-width: 760px;
    }

    .drama-credit-row {
        display: flex;
        gap: 16px;
    }

    .drama-credit-label {
        width: 75px;
        color: #7A908A;
        font-weight: 500;
        flex-shrink: 0;
    }

    .drama-credit-names {
        color: #CFDBD7;
        font-weight: 400;
    }

    /* Episodes Section Header */
    .drama-episodes-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 18px;
    }

    .drama-episodes-h2 {
        font-size: 22px;
        font-weight: 800;
        color: #FFFFFF;
        margin: 0;
    }

    .drama-episodes-total-count {
        font-size: 14px;
        color: #7A908A;
        font-weight: 600;
    }

    /* Episodes Rows List */
    .drama-episodes-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .drama-ep-row-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 14px 18px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .drama-ep-row-card:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(255, 255, 255, 0.16);
        transform: translateX(4px);
    }

    .drama-ep-row-card.active {
        background: rgba(94, 92, 230, 0.12);
        border: 1px solid rgba(94, 92, 230, 0.4);
        border-left: 4px solid #5E5CE6;
    }

    .drama-ep-left-wrap {
        display: flex;
        align-items: center;
        gap: 18px;
        flex: 1;
        min-width: 0;
    }

    .drama-ep-thumb {
        position: relative;
        width: 140px;
        height: 80px;
        flex-shrink: 0;
        border-radius: 8px;
        overflow: hidden;
        background: #14221D;
    }

    .drama-ep-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .drama-ep-thumb-disc {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.35);
        opacity: 0.9;
        transition: opacity 0.2s ease;
    }

    .drama-ep-disc-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.65);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .drama-ep-text-col {
        flex: 1;
        min-width: 0;
    }

    .drama-ep-title-h4 {
        font-size: 15px;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0 0 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .drama-ep-row-card:hover .drama-ep-title-h4 {
        color: #5E5CE6;
    }

    .drama-ep-desc-p {
        font-size: 13px;
        color: #8FA9AA;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.45;
    }

    .drama-ep-right-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .drama-ep-duration {
        font-size: 13.5px;
        color: #8FA9AA;
        font-weight: 500;
        min-width: 52px;
        text-align: right;
    }

    .drama-ep-circle-play-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.35);
        background: transparent;
        color: #FFFFFF;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
        transition: all 0.2s ease;
    }

    .drama-ep-row-card:hover .drama-ep-circle-play-btn {
        background: #5E5CE6;
        border-color: #5E5CE6;
        color: #FFFFFF;
        transform: scale(1.1);
    }

    .drama-ep-dots-menu-btn {
        background: transparent;
        border: none;
        color: #7A908A;
        cursor: pointer;
        padding: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: color 0.15s ease;
    }

    .drama-ep-dots-menu-btn:hover {
        color: #FFFFFF;
    }

    .drama-loading-state {
        padding: 60px 20px;
        text-align: center;
        color: #183B36;
    }

    .drama-spinner {
        width: 44px;
        height: 44px;
        border: 3.5px solid rgba(24, 59, 54, 0.15);
        border-top-color: #DE7149;
        border-radius: 50%;
        animation: dSpin 0.8s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes dSpin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 992px) {
        .drama-hero-row {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .drama-metadata-line, .drama-hero-buttons, .drama-credit-row {
            justify-content: center;
        }
        .drama-poster-wrap {
            width: 200px;
            min-width: 200px;
        }
        .drama-ep-desc-p {
            display: none;
        }
    }
</style>

@if (IsLoading)
{
    <div class="drama-loading-state">
        <div class="drama-spinner"></div>
        <p>Loading drama details and episodes...</p>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="drama-loading-state">
        <h3 style="color:#183B36;">Unable to load drama</h3>
        <p style="color:#5C6B64;">@ErrorMessage</p>
        <button class="drama-btn-play-hero" style="margin-top:16px;" @onclick="GoBack">Back to Home</button>
    </div>
}
else if (Drama != null)
{
    <div class="drama-theater-container">
        <!-- Top Action Bar (Back Circle on Left, Cast & Close on Right) -->
        <div class="drama-theater-top-bar">
            <button class="drama-top-circle-btn" @onclick="GoBack" title="Back to Catalog">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <div class="drama-top-right-group">
                <button class="drama-top-circle-btn" title="Cast to TV">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="2" y1="20" x2="2.01" y2="20"></line>
                        <path d="M5 20a5 5 0 0 0-5-5"></path>
                        <path d="M9 20a9 9 0 0 0-9-9"></path>
                        <path d="M2 12V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"></path>
                    </svg>
                </button>
                <button class="drama-top-circle-btn" @onclick="GoBack" title="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="18" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Video Player (Revealed when episode or play is clicked!) -->
        @if (IsPlayingVideo && AuthService.IsAuthenticated())
        {
            <div id="videoPlayerBox" class="drama-theater-player">
                <div class="drama-player-bar">
                    <div class="drama-player-title">
                        <span>@ActiveVideoTitle</span>
                        <span class="drama-ep-badge">EP @ActiveEpisodeNumber</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        @if (IsYoutubeUrl(ActiveVideoUrl))
                        {
                            <button type="button" class="btn-toggle-stream" @onclick="TogglePlayerMode" title="Toggle between YouTube & Direct Video Stream" style="background: rgba(222, 113, 73, 0.15); border: 1px solid rgba(222, 113, 73, 0.3); color: #DE7149; border-radius: 8px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 5px;">
                                @(UseDirectStream ? "📺 Switch to YouTube" : "⚡ Switch to Direct Stream")
                            </button>
                        }
                        <button type="button" class="drama-player-close" @onclick="StopPlaying" title="Close Video Player">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="18" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                </div>
                @if (IsYoutubeUrl(ActiveVideoUrl) && !UseDirectStream)
                {
                    <iframe class="drama-video" src="@ActiveVideoUrl" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%; height:480px; border-radius:12px; display:block;"></iframe>
                }
                else
                {
                    <video class="drama-video" src="@GetPlaybackUrl()" controls autoplay poster="@ActiveVideoPoster" preload="auto" style="width:100%; max-height:520px; border-radius:12px; display:block;">
                        Your browser does not support the video tag.
                    </video>
                }
            </div>
        }

        <!-- Hero Section: Cover on Left, Information on Right -->
        <div class="drama-hero-row">
            <div class="drama-poster-wrap">
                <img src="@CleanPoster(Drama.PosterUrl, Drama.Title)" alt="@Drama.Title" class="drama-poster-img" />
            </div>

            <div class="drama-info-col">
                <h1 class="drama-heading-title">@Drama.Title</h1>

                <div class="drama-metadata-line">
                    <span>@DramaYear</span>
                    <span>•</span>
                    <span>@DramaTotalEpisodesText</span>
                    <span>•</span>
                    <span>@DramaGenres</span>
                    <span class="badge-gold-hd">HD</span>
                    <span class="badge-meta-pill">@DramaAgeRating</span>
                    <span class="badge-meta-pill">@DramaLanguage</span>
                </div>

                <p class="drama-synopsis">@Drama.Description</p>

                <div class="drama-hero-buttons">
                    @if (AuthService.IsAuthenticated())
                    {
                        <button class="drama-btn-play-hero" @onclick="StartPlayingFirstEpisode">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="6 4 19 12 6 20 6 4"></polygon>
                            </svg>
                            <span>Play</span>
                        </button>
                    }
                    else
                    {
                        <a href="/login?returnUrl=/drama/@Id" class="drama-btn-play-hero" style="background:#DE7149; text-decoration:none;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            <span>Sign In to Watch</span>
                        </a>
                    }

                    <button class="drama-btn-action-hero" @onclick="ToggleWatchlist">
                        @if (IsWatchlisted)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span style="color:#10b981;">In Watchlist</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Add to Watchlist</span>
                        }
                    </button>

                    <button class="drama-btn-action-hero">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <polyline points="16 6 12 2 8 6"></polyline>
                            <line x1="12" y1="2" x2="12" y2="15"></line>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>

                <div class="drama-credits-box">
                    <div class="drama-credit-row">
                        <span class="drama-credit-label">Starring</span>
                        <span class="drama-credit-names">@DramaStarring</span>
                    </div>
                    <div class="drama-credit-row">
                        <span class="drama-credit-label">Creators</span>
                        <span class="drama-credit-names">@DramaCreators</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Episodes Section Header -->
        <div class="drama-episodes-header-row">
            <h2 class="drama-episodes-h2">Episodes</h2>
            <span class="drama-episodes-total-count">@DramaTotalEpisodesText</span>
        </div>

        <!-- Episodes Rows List -->
        <div class="drama-episodes-list">
            @if (Episodes != null && Episodes.Any())
            {
                @foreach (var ep in Episodes)
                {
                    var currentEp = ep;
                    bool isCurrentPlaying = (currentEp.EpisodeNumber == ActiveEpisodeNumber && IsPlayingVideo);
                    <div class="drama-ep-row-card @(isCurrentPlaying ? "active" : "")" @onclick="() => PlayEpisode(currentEp)">
                        <div class="drama-ep-left-wrap">
                            <div class="drama-ep-thumb">
                                <img src="@GetEpisodeThumbnail(currentEp)" alt="Episode @currentEp.EpisodeNumber" class="drama-ep-thumb-img" />
                                <div class="drama-ep-thumb-disc">
                                    <div class="drama-ep-disc-icon">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="drama-ep-text-col">
                                <h4 class="drama-ep-title-h4">@currentEp.EpisodeNumber. @(string.IsNullOrWhiteSpace(currentEp.Title) ? $"{Drama.Title} S1: Episode {currentEp.EpisodeNumber}" : currentEp.Title)</h4>
                                <p class="drama-ep-desc-p">@(string.IsNullOrWhiteSpace(currentEp.Description) ? Drama.Description : currentEp.Description)</p>
                            </div>
                        </div>

                        <div class="drama-ep-right-wrap">
                            <span class="drama-ep-duration">@(currentEp.Duration.HasValue && currentEp.Duration.Value > 0 ? $"{currentEp.Duration.Value} min" : "70 min")</span>
                            @if (AuthService.IsAuthenticated())
                            {
                                <button type="button" class="drama-ep-circle-play-btn" @onclick="() => PlayEpisode(currentEp)" title="Play Episode @currentEp.EpisodeNumber">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                    </svg>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="drama-ep-circle-play-btn" @onclick="() => PlayEpisode(currentEp)" title="Sign in to stream Episode @currentEp.EpisodeNumber" style="border-color: rgba(222, 113, 73, 0.4); color: #DE7149;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </button>
                            }
                            <button type="button" class="drama-ep-dots-menu-btn" title="Options" @onclick:stopPropagation="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="1.5"></circle>
                                    <circle cx="12" cy="12" r="1.5"></circle>
                                    <circle cx="12" cy="19" r="1.5"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding: 30px; text-align: center; color: #8FA9AA;">
                    <p>No episodes found for this series.</p>
                </div>
            }
        </div>
    </div>
}
