@page "/drama/{Id:long}"
@page "/movie/{Id:long}"
@rendermode InteractiveServer

<PageTitle>@(Drama?.Title ?? "Drama Details") - NangWorld</PageTitle>

<link rel="stylesheet" href="drama-detail.css?v=pastel-3.0" />
@if (IsLoading)
{
    <div class="drama-loading-state">
        <div class="drama-spinner"></div>
        <p>Loading drama details and episodes...</p>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="drama-loading-state">
        <h3 style="color:#183B36;">Unable to load drama</h3>
        <p style="color:#5C6B64;">@ErrorMessage</p>
        <button class="drama-btn-play-hero" style="margin-top:16px;" @onclick="GoBack">Back to Home</button>
    </div>
}
else if (Drama != null)
{
    <div class="drama-theater-container">
        <!-- Top Action Bar (Back Circle on Left, Cast & Close on Right) -->
        <div class="drama-theater-top-bar">
            <button class="drama-top-circle-btn" @onclick="GoBack" title="Back to Catalog">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <div class="drama-top-right-group">
                <button class="drama-top-circle-btn" title="Cast to TV">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="2" y1="20" x2="2.01" y2="20"></line>
                        <path d="M5 20a5 5 0 0 0-5-5"></path>
                        <path d="M9 20a9 9 0 0 0-9-9"></path>
                        <path d="M2 12V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"></path>
                    </svg>
                </button>
                <button class="drama-top-circle-btn" @onclick="GoBack" title="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="18" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Video Player (Revealed when episode or play is clicked!) -->
        @if (IsPlayingVideo && AuthService.IsAuthenticated())
        {
            <div id="videoPlayerBox" class="drama-theater-player">
                <div class="drama-player-bar">
                    <div class="drama-player-title" style="color: #2E1065 !important; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #2E1065 !important; font-weight: 800; font-size: 15px;">@ActiveVideoTitle</span>
                        <span class="drama-ep-badge">EP @ActiveEpisodeNumber</span>
                        @if (!string.IsNullOrWhiteSpace(ResumeToast))
                        {
                            <span class="drama-resume-toast">
                                ⏱️ @ResumeToast
                            </span>
                        }
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        @if (!IsYoutubeUrl(ActiveVideoUrl) && !string.IsNullOrWhiteSpace(ActiveSubtitleUrl))
                        {
                            <button type="button" class="btn-toggle-stream btn-subtitles" @onclick="ToggleSubtitles" title="Toggle Myanmar Subtitles">
                                💬 Subtitles: @(IsSubtitleEnabled ? "မြန်မာ (ON)" : "OFF")
                            </button>
                        }
                        @if (!string.IsNullOrWhiteSpace(GetTelegramLink()))
                        {
                            <button type="button" class="btn-toggle-stream btn-telegram" @onclick="OpenTelegramQrModal" title="Watch on Telegram Channel">
                                📲 Telegram (Scan QR)
                            </button>
                        }
                        @if (IsYoutubeUrl(ActiveVideoUrl))
                        {
                            <button type="button" class="btn-toggle-stream btn-stream-mode" @onclick="TogglePlayerMode" title="Toggle between YouTube & Direct Video Stream">
                                @(UseDirectStream ? "📺 Switch to YouTube" : "⚡ Switch to Direct Stream")
                            </button>
                        }
                        <button type="button" class="drama-player-close" @onclick="StopPlaying" title="Close Video Player">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="18" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                </div>
                @if (IsYoutubeUrl(ActiveVideoUrl) && !UseDirectStream)
                {
                    <iframe class="drama-video" src="@GetYouTubeEmbedUrl(ActiveVideoUrl)" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%; height:480px; border-radius:12px; display:block;"></iframe>
                }
                else
                {
                    <video id="mainVideoPlayer" class="drama-video" src="@GetPlaybackUrl()" controls autoplay poster="@ActiveVideoPoster" preload="auto" style="width:100%; max-height:520px; border-radius:12px; display:block;">
                        @if (!string.IsNullOrWhiteSpace(ActiveSubtitleUrl))
                        {
                            <track kind="subtitles" label="Myanmar (မြန်မာ)" srclang="my" src="@ActiveSubtitleUrl" default="@IsSubtitleEnabled" />
                        }
                        Your browser does not support the video tag.
                    </video>
                }
            </div>
        }

        <!-- Hero Section: Cover on Left, Information on Right -->
        <div class="drama-hero-row">
            <div class="drama-poster-wrap">
                <img src="@CleanPoster(Drama.PosterUrl, Drama.Title)" alt="@Drama.Title" class="drama-poster-img" />
            </div>

            <div class="drama-info-col">
                <h1 class="drama-heading-title">@Drama.Title</h1>

                <div class="drama-metadata-line">
                    <span>@DramaYear</span>
                    <span>•</span>
                    <span>@DramaTotalEpisodesText</span>
                    <span>•</span>
                    <span>@DramaGenres</span>
                    <span class="badge-gold-hd">HD</span>
                    <span class="badge-meta-pill">@DramaAgeRating</span>
                    <span class="badge-meta-pill">@DramaLanguage</span>
                </div>

                <p class="drama-synopsis">@Drama.Description</p>

                <div class="drama-hero-buttons">
                    @if (AuthService.IsAuthenticated())
                    {
                        <button class="drama-btn-play-hero" @onclick="StartPlayingFirstEpisode">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="6 4 19 12 6 20 6 4"></polygon>
                            </svg>
                            <span>Play</span>
                        </button>
                    }
                    else
                    {
                        <a href="/login?returnUrl=/drama/@Id" class="drama-btn-play-hero" style="background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 100%); text-decoration:none;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            <span>Sign In to Watch</span>
                        </a>
                    }

                    <button class="drama-btn-action-hero" @onclick="ToggleWatchlist">
                        @if (IsWatchlisted)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span style="color:#10b981;">In Watchlist</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Add to Watchlist</span>
                        }
                    </button>

                    <button class="drama-btn-action-hero">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                            <polyline points="16 6 12 2 8 6"></polyline>
                            <line x1="12" y1="2" x2="12" y2="15"></line>
                        </svg>
                        <span>Share</span>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(GetTelegramLink()))
                    {
                        <button type="button" class="drama-btn-action-hero" @onclick="OpenTelegramQrModal" style="color: #2AABEE; border-color: rgba(42, 171, 238, 0.4);" title="Watch on Telegram Channel @@WEAREALLTRYINGHEREMM">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                            </svg>
                            <span>Telegram Channel</span>
                        </button>
                    }
                </div>

                <div class="drama-credits-box">
                    <div class="drama-credit-row">
                        <span class="drama-credit-label">Starring</span>
                        <span class="drama-credit-names">@DramaStarring</span>
                    </div>
                    <div class="drama-credit-row">
                        <span class="drama-credit-label">Creators</span>
                        <span class="drama-credit-names">@DramaCreators</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Episodes Section Header -->
        <div class="drama-episodes-header-row">
            <h2 class="drama-episodes-h2">Episodes</h2>
            <span class="drama-episodes-total-count">@DramaTotalEpisodesText</span>
        </div>

        <!-- Episodes Rows List -->
        <div class="drama-episodes-list">
            @if (Episodes != null && Episodes.Any())
            {
                @foreach (var ep in Episodes)
                {
                    var currentEp = ep;
                    bool isCurrentPlaying = (currentEp.EpisodeNumber == ActiveEpisodeNumber && IsPlayingVideo);
                    <div class="drama-ep-row-card @(isCurrentPlaying ? "active" : "")" @onclick="() => PlayEpisode(currentEp)">
                        <div class="drama-ep-left-wrap">
                            <div class="drama-ep-thumb">
                                <img src="@GetEpisodeThumbnail(currentEp)" alt="Episode @currentEp.EpisodeNumber" class="drama-ep-thumb-img" />
                                <div class="drama-ep-thumb-disc">
                                    <div class="drama-ep-disc-icon">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="drama-ep-text-col">
                                <h4 class="drama-ep-title-h4">@currentEp.EpisodeNumber. @(string.IsNullOrWhiteSpace(currentEp.Title) ? $"{Drama.Title} S1: Episode {currentEp.EpisodeNumber}" : currentEp.Title)</h4>
                                <p class="drama-ep-desc-p">@(string.IsNullOrWhiteSpace(currentEp.Description) ? Drama.Description : currentEp.Description)</p>
                            </div>
                        </div>

                        <div class="drama-ep-right-wrap">
                            <span class="drama-ep-duration">@(currentEp.Duration.HasValue && currentEp.Duration.Value > 0 ? $"{currentEp.Duration.Value} min" : "70 min")</span>
                            @if (AuthService.IsAuthenticated())
                            {
                                <button type="button" class="drama-ep-circle-play-btn" @onclick="() => PlayEpisode(currentEp)" title="Play Episode @currentEp.EpisodeNumber">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                    </svg>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="drama-ep-circle-play-btn" @onclick="() => PlayEpisode(currentEp)" title="Sign in to stream Episode @currentEp.EpisodeNumber">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </button>
                            }
                            <button type="button" class="drama-ep-dots-menu-btn" title="Options" @onclick:stopPropagation="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="1.5"></circle>
                                    <circle cx="12" cy="12" r="1.5"></circle>
                                    <circle cx="12" cy="19" r="1.5"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding: 30px; text-align: center; color: #8FA9AA;">
                    <p>No episodes found for this series.</p>
                </div>
            }
        </div>
    </div>

    <!-- Telegram QR Code & Channel Modal (Pastel Theme) -->
    @if (ShowTelegramQrModal)
    {
        <div style="position: fixed; inset: 0; background: rgba(46, 16, 101, 0.4); backdrop-filter: blur(8px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 16px;">
            <div style="background: #FFFFFF; border: 1.5px solid rgba(167, 139, 250, 0.35); border-radius: 28px; width: 100%; max-width: 440px; padding: 32px 28px; box-shadow: 0 24px 60px rgba(139, 92, 246, 0.22); color: #2E1065; text-align: center; position: relative;">
                
                <button type="button" @onclick="CloseTelegramQrModal" style="position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: #F3E8FF; border: 1px solid rgba(167, 139, 250, 0.3); color: #4C1D95; font-size: 1.4rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
                    &times;
                </button>

                <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #0284C7 0%, #38BDF8 100%); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35);">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFFFFF">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                    </svg>
                </div>

                <h3 style="font-size: 1.3rem; font-weight: 800; color: #2E1065; margin: 0 0 6px 0;">
                    @(Drama?.Title ?? "Asian Drama")
                </h3>
                <p style="font-size: 0.95rem; color: #0284C7; font-weight: 700; margin: 0 0 16px 0;">
                    @@WEAREALLTRYINGHEREMM
                </p>

                <!-- Clay QR Code Frame -->
                <div style="background: #FFFFFF; padding: 12px; border-radius: 20px; display: inline-block; box-shadow: 0 12px 30px rgba(139, 92, 246, 0.15), inset 0 0 0 1px rgba(167, 139, 250, 0.2); margin-bottom: 16px;">
                    <img src="/images/telegram_channel_qr.jpg" alt="Telegram Channel QR" style="width: 200px; height: 200px; object-fit: contain; display: block; border-radius: 12px;" />
                </div>

                <p style="font-size: 0.85rem; color: #6B5B95; line-height: 1.5; margin: 0 0 20px 0; padding: 0 10px;">
                    ဖုန်း Camera (သို့မဟုတ်) Telegram App မှ ဤ QR Code ကို Scan ဖတ်၍ ဇာတ်လမ်းတွဲ အပိုင်းအားလုံးကို မြန်မာစာတန်းထိုးဖြင့် တိုက်ရိုက် ကြည့်ရှုနိုင်ပါသည်။
                </p>

                <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                    <a href="https://t.me/WEAREALLTRYINGHEREMM" target="_blank" rel="noopener noreferrer" style="background: linear-gradient(135deg, #0284C7 0%, #38BDF8 100%); color: #FFF; border: none; padding: 10px 24px; border-radius: 9999px; font-weight: 700; text-decoration: none; font-size: 0.9rem; box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35); display: inline-flex; align-items: center; gap: 8px;">
                        <span>Open in Telegram ↗</span>
                    </a>
                    <button type="button" @onclick="CloseTelegramQrModal" style="background: #F3E8FF; border: 1.5px solid rgba(167, 139, 250, 0.35); color: #4C1D95; padding: 10px 20px; border-radius: 9999px; font-weight: 700; cursor: pointer; font-size: 0.9rem;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }
}
