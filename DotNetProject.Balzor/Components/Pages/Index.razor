@page "/"


<!-- Top App Header -->
<header class="myflix-header">
    <div class="myflix-search-group">
        <div class="myflix-search-bar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7ea29a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search for movies, series, genres...">
        </div>
        <button type="button" class="myflix-search-btn">
            Search
        </button>
    </div>

    <div class="myflix-header-right">
        <!-- Notification Bell -->
        <button class="myflix-notif-btn" aria-label="Notifications" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="myflix-notif-dot"></span>
        </button>

        <!-- User Profile Pill -->
        <div class="myflix-user-profile">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="May Zin" class="myflix-avatar" />
            <span class="myflix-username">May Zin</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </div>
</header>

<!-- Featured Hero Banner -->
<section class="myflix-hero-banner">
    <div class="myflix-hero-backdrop">
        <div class="myflix-hero-img-wrapper">
            <img src="https://upload.wikimedia.org/wikipedia/en/9/9e/KinnPorsche_series_poster.jpg" alt="KinnPorsche Featured" class="myflix-hero-bg-img" />
        </div>
        <div class="myflix-hero-overlay"></div>
    </div>

    <div class="myflix-hero-content">
        <div class="myflix-hero-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#10b981" stroke="#10b981">
                <path d="M12 2c0 4-4 6-4 10a5 5 0 0 0 10 0c0-4-6-6-6-10z" />
            </svg>
            <span>Trending Now</span>
        </div>

        <h1 class="myflix-hero-title">
            KinnPorsche
            <span class="myflix-hero-script">The Series</span>
        </h1>

        <p class="myflix-hero-desc">
            The second son of a mafia family, Kinn, is assigned a bodyguard, Porsche. Their relationship starts with distrust and slowly develops into something more.
        </p>

        <div class="myflix-hero-actions">
            <button class="myflix-btn myflix-btn-primary" @onclick="PlayKinnPorsche">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Play Now</span>
            </button>

            <button class="myflix-btn myflix-btn-secondary" @onclick="PlayKinnPorsche">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>My List</span>
            </button>
        </div>

        <!-- Carousel Dots -->
        <div class="myflix-carousel-dots">
            <span class="dot active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </div>
</section>

<!-- Continue Watching Section (Dynamic Last Watched) -->
@if (ContinueWatchingItems != null && ContinueWatchingItems.Any())
{
    <section class="myflix-section-block">
        <div class="myflix-section-header">
            <h2>Continue Watching</h2>
            <a href="watch-later" class="myflix-see-all">See All</a>
        </div>

        <div class="myflix-continue-grid">
            @foreach (var item in ContinueWatchingItems)
            {
                <article class="myflix-continue-card" @onclick="() => ResumePlayback(item)" title="Resume @item.Title (Episode @item.EpisodeNumber)">
                    <div class="myflix-continue-thumb">
                        <img src="@item.PosterUrl" alt="@item.Title" loading="lazy" />
                        <div class="myflix-thumb-overlay">
                            <button type="button" class="myflix-play-icon-btn" aria-label="Play @item.Title">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                </svg>
                            </button>
                        </div>
                        <div class="myflix-continue-progress">
                            <div class="myflix-continue-progress-fill" style="width: @(item.ProgressPercentage)%"></div>
                        </div>
                    </div>
                    <div class="myflix-continue-info">
                        <h3>@item.Title</h3>
                        <p>@(item.IsContent ? $"Episode {item.EpisodeNumber}" : "Movie")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}

<!-- Thai BL Series Section -->
<section class="myflix-section-block">
    <div class="myflix-section-header">
        <h2>Thai BL Series</h2>
        <a href="category/thai-bl" class="myflix-see-all">See All</a>
    </div>

    @if (IsLoading)
    {
        <div class="myflix-loading">
            <p>Loading...</p>
        </div>
    }
    else if (Thais != null && Thais.Any())
    {
        <div class="myflix-poster-grid">
            @foreach (var thai in Thais)
            {
                <article class="myflix-poster-card" style="cursor:pointer;" @onclick="() => NavigateToDrama(thai.Id)">
                    <img src="@thai.PosterUrl" alt="@thai.Title" class="myflix-poster-img" />
                    <button class="myflix-card-heart @(FavoriteThaiIds.Contains(thai.Id) ? "active" : "")"
                            title="@(FavoriteThaiIds.Contains(thai.Id) ? "Remove from Favorites" : "Add to Favorites")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavoriteThai(thai)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="@(FavoriteThaiIds.Contains(thai.Id) ? "#DE7149" : "none")" stroke="@(FavoriteThaiIds.Contains(thai.Id) ? "#DE7149" : "currentColor")" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <div class="myflix-poster-content">
                        <h3>@thai.Title</h3>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="myflix-no-data">
            <p>No Thai series available at the moment.</p>
        </div>
    }
</section>
<!-- Korean Dramas Section -->
<section class="myflix-section-block">
    <div class="myflix-section-header">
        <h2>Korean Dramas</h2>
        <a href="category/korean-drama" class="myflix-see-all">See All</a>
    </div>

    <!--Using Db Section-->
    @if (IsLoading)
    {
        <div class="myflix-loading">
            <p>Loading...</p>
        </div>
    }
    else if (Dramas != null && Dramas.Any())
    {
        <div class="myflix-poster-grid">
            @foreach (var drama in Dramas)
            {
                <article class="myflix-poster-card" style="cursor:pointer;" @onclick="() => PlayDramaAsync(drama.ContentId, drama.Title, drama.Description, drama.PosterUrl)">
                    <img src="@drama.PosterUrl" alt="@drama.Title" class="myflix-poster-img" />
                    <button class="myflix-card-heart @(FavoriteDramaIds.Contains(drama.ContentId) ? "active" : "")"
                            title="@(FavoriteDramaIds.Contains(drama.ContentId) ? "Remove from Favorites" : "Add to Favorites")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavoriteDrama(drama)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="@(FavoriteDramaIds.Contains(drama.ContentId) ? "#DE7149" : "none")" stroke="@(FavoriteDramaIds.Contains(drama.ContentId) ? "#DE7149" : "currentColor")" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <div class="myflix-poster-content">
                        <h3>@drama.Title</h3>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="myflix-no-data">
            <p>No Korean dramas available at the moment.</p>
        </div>
    }

</section>

<!--Movie Section -->
<section class="myflix-section-block">
    <div class="myflix-section-header">
        <h2>Movies</h2>
        <a href="category/korean-drama" class="myflix-see-all">See All</a>
    </div>

    <div class="myflix-poster-grid">
        @if (IsLoading)
        {
            <div class="myflix-loading">
                <p>Loading...</p>
            </div>
        }
        else if (Movies != null && Movies.Any())
        {
            @foreach (var movie in Movies)
            {
                <article class="myflix-poster-card" style="cursor:pointer;" @onclick="() => NavigateToDrama(movie.Id)">
                    <img src="@movie.PosterUrl" alt="@movie.Title" class="myflix-poster-img" />
                    <button class="myflix-card-heart @(FavoriteMovieIds.Contains(movie.Id) ? "active" : "")"
                            title="@(FavoriteMovieIds.Contains(movie.Id) ? "Remove from Favorites" : "Add to Favorites")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavoriteMovie(movie)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="@(FavoriteMovieIds.Contains(movie.Id) ? "#DE7149" : "none")" stroke="@(FavoriteMovieIds.Contains(movie.Id) ? "#DE7149" : "currentColor")" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <div class="myflix-poster-content">
                        <h3>@movie.Title</h3>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="myflix-no-data">
                <p>No movies available at the moment.</p>
            </div>
        }

    </div>
</section>