<!-- Korean Dramas Section -->
<section class="myflix-section-block">
    <div class="myflix-section-header">
        <h2>Korean Dramas</h2>
        <a href="category/korean-drama" class="myflix-see-all">See All</a>
    </div>

    <!--Using Db Section-->
    @if (IsLoading)
    {
        <div class="myflix-loading">
            <p>Loading...</p>
        </div>
    }
    else if (Dramas != null && Dramas.Any())
    {
        <div class="myflix-poster-grid">
            @foreach (var drama in Dramas)
            {
                <article class="myflix-poster-card" style="cursor:pointer;" @onclick="() => PlayDramaAsync(drama.ContentId, drama.Title, drama.Description, drama.PosterUrl)">
                    <img src="@drama.PosterUrl" alt="@drama.Title" class="myflix-poster-img" />
                    <button class="myflix-card-heart"
                            title="Favorite">

                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <div class="myflix-poster-content">
                        <h3>@drama.Title</h3>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="myflix-no-data">
            <p>No Korean dramas available at the moment.</p>
        </div>
    }

</section>

<!--Movie Section -->
<section class="myflix-section-block">
    <div class="myflix-section-header">
        <h2>Movies</h2>
        <a href="category/korean-drama" class="myflix-see-all">See All</a>
    </div>

    <div class="myflix-poster-grid">
        @if (IsLoading)
        {
            <div class="myflix-loading">
                <p>Loading...</p>
            </div>
        }
        else if (Movies != null && Movies.Any())
        {
            @foreach (var movie in Movies)
            {
                <article class="myflix-poster-card">
                    <img src="@movie.PosterUrl" alt="@movie.Title" class="myflix-poster-img" />
                    <button class="myflix-card-heart"
                            title="Favorite">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <div class="myflix-poster-content">
                        <h3>@movie.Title</h3>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="myflix-no-data">
                <p>No movies available at the moment.</p>
            </div>
        }

    </div>
</section>


<!-- ========================================================
     DRAMA DETAIL & EPISODES STREAMING VIEW (IMAGE 2 DESIGN)
     ======================================================== -->
@if (IsVideoModalOpen)
{
    <div class="drama-detail-backdrop" @onclick="CloseVideoPlayer">
        <div class="drama-detail-container" @onclick:stopPropagation="true">
            <!-- Top Navigation Bar -->
            <div class="drama-nav-bar">
                <button class="drama-back-btn" @onclick="CloseVideoPlayer" title="Back">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                <div class="drama-nav-actions">
                    <button class="drama-nav-icon-btn" title="Cast to TV">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="2" y1="20" x2="2.01" y2="20"></line>
                            <path d="M5 20a5 5 0 0 0-5-5"></path>
                            <path d="M9 20a9 9 0 0 0-9-9"></path>
                            <path d="M2 12V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"></path>
                        </svg>
                    </button>
                    <button class="drama-nav-icon-btn" @onclick="CloseVideoPlayer" title="Close">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Integrated Video Player (appears when playing) -->
            @if (IsPlayingVideo)
            {
                <div class="drama-player-container">
                    <div class="drama-player-top">
                        <div class="drama-player-title">
                            <span>@ActiveVideoTitle</span>
                            <span class="drama-player-badge">EP @ActiveEpisodeNumber</span>
                        </div>
                        <button class="drama-nav-icon-btn" @onclick="StopPlayingVideo" title="Close Player">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <video class="drama-player-video" src="@ActiveVideoUrl" controls autoplay poster="@ActiveVideoPoster" preload="auto">
                        Your browser does not support the video tag.
                    </video>
                </div>
            }

            <!-- Hero Section: Cover + Details -->
            <div class="drama-hero-section">
                <div class="drama-poster-wrap">
                    <img src="@ActiveDramaPoster" alt="@ActiveDramaTitle" class="drama-poster-img" />
                </div>
                <div class="drama-info-col">
                    <h1 class="drama-title">@ActiveDramaTitle</h1>
                    
                    <div class="drama-meta-row">
                        <span>@DramaYear</span>
                        <span class="drama-meta-dot">•</span>
                        <span>@DramaTotalEpisodesText</span>
                        <span class="drama-meta-dot">•</span>
                        <span>@DramaGenres</span>
                        <span class="badge-hd">HD</span>
                        <span class="badge-pill">@DramaAgeRating</span>
                        <span class="badge-pill">@DramaLanguage</span>
                    </div>

                    <p class="drama-synopsis">@ActiveDramaDescription</p>

                    <div class="drama-action-buttons">
                        <button class="drama-btn-play" @onclick="StartPlaying">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>Play</span>
                        </button>

                        <button class="drama-btn-secondary" @onclick="ToggleWatchlist">
                            @if (IsWatchlisted)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span style="color:#10b981;">In Watchlist</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add to Watchlist</span>
                            }
                        </button>

                        <button class="drama-btn-secondary" @onclick="ShareDrama">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                <polyline points="16 6 12 2 8 6"></polyline>
                                <line x1="12" y1="2" x2="12" y2="15"></line>
                            </svg>
                            <span>Share</span>
                        </button>
                    </div>

                    <div class="drama-credits">
                        <div class="drama-credits-row">
                            <span class="drama-credits-label">Starring</span>
                            <span class="drama-credits-value">@DramaStarring</span>
                        </div>
                        <div class="drama-credits-row">
                            <span class="drama-credits-label">Creators</span>
                            <span class="drama-credits-value">@DramaCreators</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Episodes Section Header -->
            <div class="drama-episodes-header">
                <h2 class="drama-episodes-heading">Episodes</h2>
                <span class="drama-episodes-count">@DramaTotalEpisodesText</span>
            </div>

            <!-- Episodes List (Horizontal Rows like Image 2) -->
            <div class="drama-episode-list">
                @if (ActiveEpisodes != null && ActiveEpisodes.Any())
                {
                    @foreach (var ep in ActiveEpisodes)
                    {
                        var currentEp = ep;
                        bool isCurrentPlaying = (currentEp.EpisodeNumber == ActiveEpisodeNumber && IsPlayingVideo);
                        <div class="drama-ep-row @(isCurrentPlaying ? "active" : "")" @onclick="() => PlayEpisodeFromRow(currentEp)">
                            <div class="drama-ep-thumb-box">
                                <img src="@GetEpisodeThumbnail(currentEp)" alt="Episode @currentEp.EpisodeNumber" class="drama-ep-thumb-img" />
                                <div class="drama-ep-play-overlay">
                                    <div class="drama-ep-play-disc">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="drama-ep-info">
                                <h4 class="drama-ep-title">@currentEp.EpisodeNumber. @(string.IsNullOrWhiteSpace(currentEp.Title) ? $"Episode {currentEp.EpisodeNumber}" : currentEp.Title)</h4>
                                <p class="drama-ep-desc">@(string.IsNullOrWhiteSpace(currentEp.Description) ? ActiveDramaDescription : currentEp.Description)</p>
                            </div>
                            <div class="drama-ep-right">
                                <span class="drama-ep-duration">@(currentEp.Duration.HasValue && currentEp.Duration.Value > 0 ? $"{currentEp.Duration.Value} min" : "70 min")</span>
                                <button class="drama-ep-circle-play" title="Play Episode @currentEp.EpisodeNumber">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 19 12 6 20 6 4"></polygon>
                                    </svg>
                                </button>
                                <button class="drama-ep-dots" title="More options" @onclick:stopPropagation="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="1"></circle>
                                        <circle cx="12" cy="5" r="1"></circle>
                                        <circle cx="12" cy="19" r="1"></circle>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 24px; text-align: center; color: #8C9993;">
                        <p>No episodes found for this series.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}