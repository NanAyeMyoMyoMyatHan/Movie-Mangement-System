@page "/profile"
@rendermode InteractiveServer

<PageTitle>My Profile - NangWorld</PageTitle>

<div class="profile-container">
    <div class="profile-header-banner">
        <div class="profile-header-info">
            <h1 class="profile-title">Account Settings</h1>
            <p class="profile-subtitle">Manage your personal profile, customize your avatar, and update your security credentials.</p>
        </div>
        <div class="profile-header-badge">
            <span class="role-pill">@UserProfile?.Role</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @(IsStatusSuccess ? "alert-success" : "alert-danger") profile-alert" role="alert">
            <span>@(IsStatusSuccess ? "✓ " : "⚠️ ") @StatusMessage</span>
            <button type="button" class="btn-close" @onclick="() => StatusMessage = null" aria-label="Close"></button>
        </div>
    }

    <div class="profile-grid">
        <!-- Left Column: Avatar & Quick Info Card -->
        <div class="profile-card avatar-card">
            <h2 class="card-heading">Profile Picture</h2>
            <div class="avatar-preview-wrapper">
                @if (!string.IsNullOrWhiteSpace(PreviewAvatarUrl ?? UserProfile?.AvatarUrl))
                {
                    <img src="@(PreviewAvatarUrl ?? UserProfile?.AvatarUrl)" alt="User Avatar" class="profile-avatar-large" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        @(string.IsNullOrWhiteSpace(UserProfile?.DisplayName) ? "U" : UserProfile.DisplayName.Substring(0, 1).ToUpper())
                    </div>
                }
            </div>

            <div class="avatar-upload-box">
                <label class="custom-file-upload">
                    <InputFile OnChange="HandleAvatarFileSelected" accept="image/png,image/jpeg,image/webp" />
                    <span>📷 Upload New Avatar</span>
                </label>
                <small class="upload-hint">Supported formats: JPG, PNG, WEBP (Max 5MB)</small>
                @if (IsUploadingAvatar)
                {
                    <div class="uploading-spinner">
                        <span class="spinner-border spinner-border-sm" role="status"></span> Uploading...
                    </div>
                }
            </div>

            <hr class="card-divider" />

            <div class="quick-meta-list">
                <div class="quick-meta-item">
                    <span class="meta-label">Username</span>
                    <span class="meta-val">@@@UserProfile?.UserName</span>
                </div>
                <div class="quick-meta-item">
                    <span class="meta-label">Email</span>
                    <span class="meta-val">@UserProfile?.Email</span>
                </div>
                <div class="quick-meta-item">
                    <span class="meta-label">Member Since</span>
                    <span class="meta-val">@(UserProfile?.CreatedDate.ToString("MMMM yyyy") ?? "Recently")</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Edit Profile & Password Change Cards -->
        <div class="profile-form-column">
            <!-- Profile Info Form -->
            <div class="profile-card">
                <h2 class="card-heading">Personal Details</h2>
                <div class="form-group mb-3">
                    <label class="form-label">Display Name</label>
                    <input type="text" class="form-control pastel-input" @bind="DisplayNameInput" placeholder="Enter your display name" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Bio / About Me</label>
                    <textarea class="form-control pastel-textarea" rows="3" @bind="BioInput" placeholder="Tell other movie lovers a bit about yourself..."></textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn pastel-btn-primary" @onclick="SaveProfileAsync" disabled="@IsSavingProfile">
                        @if (IsSavingProfile)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>💾 Save Changes</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Password Change Form -->
            <div class="profile-card mt-4">
                <h2 class="card-heading">Change Password</h2>
                <p class="card-subheading">Update your password regularly to keep your NangWorld account secure.</p>

                <div class="form-group mb-3">
                    <label class="form-label">Current Password</label>
                    <input type="password" class="form-control pastel-input" @bind="CurrentPasswordInput" placeholder="••••••••" />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" class="form-control pastel-input" @bind="NewPasswordInput" placeholder="Min 6 characters" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control pastel-input" @bind="ConfirmNewPasswordInput" placeholder="Repeat new password" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn pastel-btn-security" @onclick="ChangePasswordAsync" disabled="@IsChangingPassword">
                        @if (IsChangingPassword)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>🔒 Update Password</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 24px 16px 60px;
    }

    .profile-header-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #FDF8FF, #F5F3FF);
        border: 1px solid rgba(167, 139, 250, 0.3);
        border-radius: 20px;
        padding: 28px 36px;
        margin-bottom: 28px;
        box-shadow: 0 8px 24px rgba(139, 92, 246, 0.06);
    }

    .profile-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 30px;
        font-weight: 700;
        color: #2E1065;
        margin: 0 0 6px 0;
    }

    .profile-subtitle {
        color: #6B7280;
        font-size: 14px;
        margin: 0;
    }

    .role-pill {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 700;
        padding: 6px 18px;
        border-radius: 9999px;
        box-shadow: 0 4px 14px rgba(139, 92, 246, 0.25);
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 28px;
    }

    @@media (max-width: 840px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    .profile-card {
        background: #FFFFFF;
        border: 1px solid rgba(167, 139, 250, 0.22);
        border-radius: 18px;
        padding: 26px;
        box-shadow: 0 4px 20px rgba(139, 92, 246, 0.05);
    }

    .card-heading {
        font-size: 18px;
        font-weight: 700;
        color: #2E1065;
        margin-bottom: 18px;
    }

    .card-subheading {
        font-size: 13px;
        color: #6B7280;
        margin-bottom: 16px;
    }

    .avatar-preview-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .profile-avatar-large {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #F5F3FF;
        box-shadow: 0 8px 24px rgba(139, 92, 246, 0.18);
    }

    .profile-avatar-placeholder {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #A78BFA, #EC4899);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 52px;
        font-weight: 800;
        box-shadow: 0 8px 24px rgba(139, 92, 246, 0.2);
    }

    .avatar-upload-box {
        text-align: center;
        margin-bottom: 20px;
    }

    .custom-file-upload {
        display: inline-block;
        padding: 9px 20px;
        cursor: pointer;
        background: #FDF8FF;
        border: 1.5px dashed #A78BFA;
        border-radius: 9999px;
        color: #7C3AED;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .custom-file-upload:hover {
        background: #F5F3FF;
        border-color: #8B5CF6;
        color: #6D28D9;
    }

    .custom-file-upload input[type="file"] {
        display: none;
    }

    .upload-hint {
        display: block;
        color: #9CA3AF;
        font-size: 11px;
        margin-top: 6px;
    }

    .card-divider {
        border-color: rgba(167, 139, 250, 0.15);
        margin: 20px 0;
    }

    .quick-meta-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .quick-meta-item {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
    }

    .meta-label {
        color: #6B7280;
        font-weight: 600;
    }

    .meta-val {
        color: #2E1065;
        font-weight: 700;
    }

    .pastel-input, .pastel-textarea {
        border: 1px solid rgba(167, 139, 250, 0.35);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 14px;
        background: #FDFBF7;
        transition: all 0.2s ease;
    }

    .pastel-input:focus, .pastel-textarea:focus {
        border-color: #8B5CF6;
        background: #FFFFFF;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
        outline: none;
    }

    .pastel-btn-primary {
        background: linear-gradient(135deg, #8B5CF6, #A78BFA);
        color: #FFFFFF;
        font-weight: 700;
        border-radius: 9999px;
        padding: 9px 24px;
        border: none;
        box-shadow: 0 4px 14px rgba(139, 92, 246, 0.25);
        transition: all 0.2s ease;
    }

    .pastel-btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #7C3AED, #9333EA);
        color: #FFFFFF;
        transform: translateY(-1px);
    }

    .pastel-btn-security {
        background: linear-gradient(135deg, #EC4899, #F43F5E);
        color: #FFFFFF;
        font-weight: 700;
        border-radius: 9999px;
        padding: 9px 24px;
        border: none;
        box-shadow: 0 4px 14px rgba(236, 72, 153, 0.25);
        transition: all 0.2s ease;
    }

    .pastel-btn-security:hover:not(:disabled) {
        background: linear-gradient(135deg, #DB2777, #E11D48);
        color: #FFFFFF;
        transform: translateY(-1px);
    }
</style>
