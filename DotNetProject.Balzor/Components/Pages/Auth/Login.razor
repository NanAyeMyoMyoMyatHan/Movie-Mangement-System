@page "/login"
@page "/signin"
@layout DotNetProject.Balzor.Components.Layout.EmptyLayout
@using DotNetProject.Balzor.Components.Shared
@using DotNetProject.Balzor.Components.Layout
@inject AuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Sign In — NangWorld</PageTitle>

<div class="login-wrapper">
    <!-- Ambient Background Glows (Soft Violet & Soft Pink) -->
    <div class="login-ambient-violet"></div>
    <div class="login-ambient-pink"></div>

    <div class="login-card">
        <!-- Logo & Brand with Violet/Pink Gradient -->
        <div class="login-brand">
            <a href="/" class="login-logo-link">
                <div class="login-logo-badge">
                    <svg class="login-logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M6 3.5c0-.9 1-.1.4.1l13.5 7.5c.8.5.8 1.6 0 2.1L7.4 20.6c-.6.4-1.4 0-1.4-.8V3.5z" fill="url(#loginBrandGrad)" />
                        <defs>
                            <linearGradient id="loginBrandGrad" x1="6" y1="3.5" x2="20" y2="20.6" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#A78BFA" />
                                <stop offset="1" stop-color="#F472B6" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <span class="login-logo-text">
                    <span class="logo-pink">Nang</span><span class="logo-violet">World</span>
                </span>
            </a>
            <p class="login-tagline">Stream the finest Asian dramas, movies, and series.</p>
        </div>

        <!-- Mode Tabs: Sign In / Create Account -->
        <div class="login-mode-tabs">
            <button type="button" class="login-tab-btn @(IsRegisterMode ? "" : "active")" @onclick="() => SetMode(false)">
                Sign In
            </button>
            <button type="button" class="login-tab-btn @(IsRegisterMode ? "active" : "")" @onclick="() => SetMode(true)">
                Create Account
            </button>
        </div>


        <!-- Error Notification -->
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-alert error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@ErrorMessage</span>
            </div>
        }

        <!-- Success Notification -->
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="login-alert success">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>@SuccessMessage</span>
            </div>
        }

        @if (!IsRegisterMode)
        {
            <!-- Sign In Form -->
            <form @onsubmit="HandleLogin" class="login-form" autocomplete="off">
                <div class="form-group">
                    <label for="usernameInput" class="form-label">Username or Email</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <input id="usernameInput" 
                               name="login_user_field" 
                               type="text" 
                               class="form-input" 
                               placeholder="e.g. admin or nang" 
                               @bind="LoginUsername" 
                               autocomplete="off" 
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="passwordInput" class="form-label">Password</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input id="passwordInput" 
                               name="login_password_field" 
                               type="@(ShowPassword ? "text" : "password")" 
                               class="form-input" 
                               placeholder="Enter password" 
                               @bind="LoginPassword" 
                               autocomplete="new-password" 
                               required />
                        <button type="button" class="btn-toggle-eye" @onclick="() => ShowPassword = !ShowPassword" title="Toggle password visibility">
                            @if (ShowPassword)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="form-actions-row">
                    <label class="remember-label">
                        <input type="checkbox" @bind="RememberMe" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button type="submit" class="btn-login-submit" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="login-spinner"></span>
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    }
                </button>
            </form>
        }
        else
        {
            <!-- Create Account Form -->
            <form @onsubmit="HandleRegister" class="login-form" autocomplete="off">
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <input type="text" class="form-input" placeholder="Choose a username" @bind="RegUsername" autocomplete="off" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Full / Display Name</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <input type="text" class="form-input" placeholder="Your display name" @bind="RegDisplayName" autocomplete="off" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <input type="email" class="form-input" placeholder="you@example.com" @bind="RegEmail" autocomplete="off" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input type="password" class="form-input" placeholder="Create password" @bind="RegPassword" autocomplete="new-password" required />
                    </div>
                </div>

                <button type="submit" class="btn-login-submit" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="login-spinner"></span>
                        <span>Creating Account...</span>
                    }
                    else
                    {
                        <span>Create Account</span>
                    }
                </button>
            </form>
        }

        <!-- Guest link / Back to catalog -->
        <div class="login-footer">
            <a href="/" class="login-guest-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                <span>Continue as Guest to NangWorld</span>
            </a>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        background: linear-gradient(145deg, #FAF5FF 0%, #F5EEFD 45%, #FDF2F8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .login-ambient-violet {
        position: absolute;
        top: -120px;
        left: -120px;
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, rgba(250, 245, 255, 0) 70%);
        pointer-events: none;
    }

    .login-ambient-pink {
        position: absolute;
        bottom: -140px;
        right: -120px;
        width: 560px;
        height: 560px;
        background: radial-gradient(circle, rgba(236, 72, 153, 0.14) 0%, rgba(253, 242, 248, 0) 70%);
        pointer-events: none;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1.5px solid rgba(167, 139, 250, 0.35);
        border-radius: 26px;
        padding: 38px 34px;
        box-shadow: 
            0 24px 60px rgba(139, 92, 246, 0.15),
            0 0 30px rgba(236, 72, 153, 0.08);
        position: relative;
        z-index: 2;
        color: #2E1065;
    }

    .login-brand {
        text-align: center;
        margin-bottom: 24px;
    }

    .login-logo-link {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        margin-bottom: 8px;
    }

    .login-logo-badge {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(167, 139, 250, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(139, 92, 246, 0.25);
    }

    .login-logo-text {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .logo-pink {
        color: #EC4899;
        text-shadow: 0 0 12px rgba(236, 72, 153, 0.25);
    }

    .logo-violet {
        color: #8B5CF6;
        text-shadow: 0 0 12px rgba(139, 92, 246, 0.25);
    }

    .login-tagline {
        font-size: 13px;
        color: #6B5B95;
        margin: 0;
    }

    /* Mode Tabs */
    .login-mode-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        background: #F3E8FF;
        border: 1px solid rgba(167, 139, 250, 0.3);
        padding: 5px;
        border-radius: 14px;
        margin-bottom: 20px;
    }

    .login-tab-btn {
        background: transparent;
        border: none;
        color: #4C1D95;
        padding: 9px 14px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .login-tab-btn.active {
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 100%);
        color: #FFFFFF;
        box-shadow: 0 4px 16px rgba(139, 92, 246, 0.35);
    }

    /* Alerts */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .login-alert.error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #DC2626;
    }

    .login-alert.success {
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(167, 139, 250, 0.45);
        color: #6D28D9;
    }

    /* Form Styles */
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #4C1D95;
    }

    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #8B5CF6;
        pointer-events: none;
    }

    .form-input {
        width: 100%;
        background: #FFFFFF;
        border: 1.5px solid rgba(167, 139, 250, 0.35);
        color: #2E1065;
        border-radius: 12px;
        padding: 12px 42px 12px 42px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        box-sizing: border-box;
    }

    .form-input::placeholder {
        color: #9382B2;
    }

    .form-input:focus {
        border-color: #8B5CF6;
        box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.25);
    }

    .btn-toggle-eye {
        position: absolute;
        right: 12px;
        background: transparent;
        border: none;
        color: #7E6B9B;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease;
    }

    .btn-toggle-eye:hover {
        color: #EC4899;
    }

    .form-actions-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12.5px;
        color: #6B5B95;
    }

    .remember-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
    }

    .remember-label input[type="checkbox"] {
        accent-color: #8B5CF6;
    }

    .btn-login-submit {
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 100%);
        color: #FFFFFF;
        border: none;
        border-radius: 14px;
        padding: 13px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(139, 92, 246, 0.35);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 6px;
    }

    .btn-login-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 26px rgba(236, 72, 153, 0.45);
    }

    .btn-login-submit:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    .login-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #FFFFFF;
        border-radius: 50%;
        animation: lSpin 0.7s linear infinite;
    }

    @@keyframes lSpin {
        to { transform: rotate(360deg); }
    }

    .login-footer {
        margin-top: 26px;
        padding-top: 20px;
        border-top: 1px solid rgba(167, 139, 250, 0.25);
        text-align: center;
    }

    .login-guest-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6B5B95;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: color 0.15s ease;
    }

    .login-guest-link:hover {
        color: #EC4899;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool IsRegisterMode = false;
    private bool ShowPassword = false;
    private bool RememberMe = true;
    private bool IsSubmitting = false;

    private string LoginUsername = "";
    private string LoginPassword = "";

    private string RegUsername = "";
    private string RegDisplayName = "";
    private string RegEmail = "";
    private string RegPassword = "";

    private string? ErrorMessage;
    private string? SuccessMessage;

    protected override void OnInitialized()
    {
        LoginUsername = "";
        LoginPassword = "";

        // If already logged in with admin privileges via Dynamic RBAC, directly go to admin
        if (AuthService.CanAccessAdmin())
        {
            Nav.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/admin" : ReturnUrl);
        }
        else if (AuthService.IsAuthenticated())
        {
            Nav.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl);
        }
    }

    private void SetMode(bool isRegister)
    {
        IsRegisterMode = isRegister;
        LoginUsername = "";
        LoginPassword = "";
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;

        try
        {
            var res = await AuthService.LoginAsync(LoginUsername, LoginPassword);
            if (res != null && res.IsSuccess)
            {
                // Dynamic RBAC Evaluation: Check if user has admin/management capabilities
                bool canAccessAdmin = AuthService.CanAccessAdmin();

                if (canAccessAdmin)
                {
                    SuccessMessage = $"Admin access verified! Welcome, {AuthService.CurrentUser.DisplayName}. Redirecting to Admin Dashboard...";
                    StateHasChanged();
                    await Task.Delay(300);
                    Nav.NavigateTo("/admin", forceLoad: true);
                }
                else
                {
                    SuccessMessage = $"Welcome back, {AuthService.CurrentUser.DisplayName}! Redirecting...";
                    StateHasChanged();
                    await Task.Delay(300);
                    var target = (!string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.Contains("admin", StringComparison.OrdinalIgnoreCase))
                        ? ReturnUrl
                        : "/";
                    Nav.NavigateTo(target, forceLoad: true);
                }
            }
            else
            {
                ErrorMessage = res?.Message ?? "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Login failed: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task HandleRegister()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;

        try
        {
            var res = await AuthService.RegisterAsync(RegUsername, RegDisplayName, RegEmail, RegPassword);
            if (res != null && res.IsSuccess)
            {
                SuccessMessage = "Account created successfully! Signing in...";
                StateHasChanged();
                await Task.Delay(1000);
                LoginUsername = RegUsername;
                LoginPassword = RegPassword;
                IsRegisterMode = false;
                await HandleLogin();
            }
            else
            {
                ErrorMessage = res?.Message ?? "Registration failed.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Registration error: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
